# Forked from Alpine community (3.9-r2) for the Meizu 20 SSC sensors
# round (2026-10-03): carries the liuqin SSC stability patches. 0003 is
# load-bearing on this device - the kwin claim lands re-entrantly inside
# the coldplug discovery (sync wrappers iterate the main context), gets
# recorded as an absent-sensor claim, and the accelerometer then never
# starts (light/compass/proximity fine, accel stream dead, rotation
# button gone; observed on r50/r51 boots while r19 won the race).
# 0004-0006 = SSC polling serialization / pending-claim release /
# availability broadcast from the same stack.
maintainer="ri <ri@example.com>"
pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=3
pkgdesc="IIO sensors to D-Bus proxy"
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
arch="all"
license="GPL-2.0-or-later"
depends="dbus"
makedepends="
	eudev-dev
	glib-dev
	libgudev-dev
	meson
	polkit-dev
	libssc-dev
	"
subpackages="$pkgname-openrc $pkgname-systemd $pkgname-udev $pkgname-dbg"
source="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/$pkgver/iio-sensor-proxy-$pkgver.tar.gz
	iio-sensor-proxy.initd
	0003-iio-sensor-proxy-start-preclaimed-coldplug-sensor.patch
	0004-iio-sensor-proxy-serialize-ssc-accel-polling.patch
	0005-iio-sensor-proxy-cancel-released-pending-claims.patch
	0006-iio-sensor-proxy-broadcast-sensor-availability.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dssc-support=enabled \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}

