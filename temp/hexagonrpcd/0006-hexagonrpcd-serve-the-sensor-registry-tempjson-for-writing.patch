From 88ea5c7b3740d625405e5ab6e2bb00f1ce8576ec Mon Sep 17 00:00:00 2001
From: ri <ri@localhost>
Date: Thu, 26 Nov 2026 05:51:49 +0800
Subject: [PATCH] hexagonrpcd: serve the sensor registry temp.json for writing

The sensor PD rebuilds its thermal registry scratch file (temp.json) on
every initialization; on stock Android this lives on the rw persist
partition. Upstream refuses every open-for-writing at the apps_std
layer (AEE_EUNSUPPORTED), so the PD burns a bounded retry storm
(~980 attempts per boot on the Meizu 20) and journal spam.

Add narrow write support:

- hexagonfs: new write op + writable mapped variant (O_RDWR|O_CREAT|
  O_TRUNC, write-reported stat) used only by dirents constructed for
  temp.json; every other path keeps the read-only service shape.
- apps_std: accept write opens that resolve to such a dirent (absolute
  paths resolve from the virtual root), implement FWRITE (official
  method id 5) symmetrically to FREAD with a malformed-decode guard.
- rpcd_builder: map temp.json into the persist/sensors/registry
  virtual directory, pointing at <root>/mnt/vendor/persist/sensors/
  registry/temp.json (create the file and its parent dirs out of
  band; make it writable by the daemon user).
---
 hexagonrpcd/apps_std.c              | 78 ++++++++++++++++++++++++++--
 hexagonrpcd/hexagonfs.c             | 17 +++++++
 hexagonrpcd/hexagonfs.h             |  3 ++
 hexagonrpcd/hexagonfs_mapped.c      | 79 +++++++++++++++++++++++++++++
 hexagonrpcd/interfaces/apps_std.def |  1 +
 hexagonrpcd/rpcd_builder.c          | 31 +++++++++--
 6 files changed, 202 insertions(+), 7 deletions(-)

diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index 0fcd53c..9d75f3b 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -120,6 +120,47 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+	} *first_out = outbufs[0].p;
+	ssize_t ret;
+
+	/*
+	 * Guard against a malformed or misdecoded buffer descriptor: the
+	 * requested length must fit the actual payload buffer, and the
+	 * descriptor must carry a writable file (everything else refuses
+	 * below and leaves the read-only service shape intact).
+	 */
+	if (first_in->buf_size > inbufs[1].s)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_write(ctx->fds, first_in->fd,
+			      first_in->buf_size, inbufs[1].p);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write file: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("write(%u, %u) -> %ld\n", first_in->fd,
+					 first_in->buf_size,
+					 ret);
+#endif
+
+	first_out->written = ret;
+
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -178,9 +219,35 @@ static uint32_t apps_std_fopen_with_env(void *data,
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
 	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
+		/*
+		 * Narrow write support (sensor PD temp.json scratch file,
+		 * see hexagonfs_mapped.c): only requests that resolve to a
+		 * dirent built with the writable mapped operations get a
+		 * real descriptor; everything else keeps the upstream
+		 * read-only refusal. Write opens are absolute paths, so
+		 * resolve from the virtual root.
+		 */
+		fd = hexagonfs_openat(ctx->fds, ctx->rootfd, ctx->rootfd,
+				      (const char *) inbufs[3].p);
+		if (fd >= 0 && ctx->fds[fd]->ops->write == NULL) {
+			hexagonfs_close(ctx->fds, fd);
+			fd = -ENOSYS;
+		}
+
+		if (fd < 0) {
+			fprintf(stderr, "Tried to open %s for writing\n",
+					(const char *) inbufs[3].p);
+			return AEE_EUNSUPPORTED;
+		}
+
+#ifdef HEXAGONRPC_VERBOSE
+		printf("openat(%s) -> %d (write)\n",
+		       (const char *) inbufs[3].p, fd);
+#endif
+
+		*out = fd;
+
+		return 0;
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -439,7 +506,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_fread_def,
 		.impl = apps_std_fread,
 	},
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fwrite_def,
+		.impl = apps_std_fwrite,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..122151e 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -244,6 +244,23 @@ ssize_t hexagonfs_read(struct hexagonfs_fd **fds, int fileno, size_t size, void
 	return fd->ops->read(fd, size, ptr);
 }
 
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -ENOSYS;
+
+	return fd->ops->write(fd, size, ptr);
+}
+
 int hexagonfs_readdir(struct hexagonfs_fd **fds, int fileno, size_t ent_size, char *ent)
 {
 	struct hexagonfs_fd *fd;
diff --git a/hexagonrpcd/hexagonfs.h b/hexagonrpcd/hexagonfs.h
index 7682604..7dc4ca3 100644
--- a/hexagonrpcd/hexagonfs.h
+++ b/hexagonrpcd/hexagonfs.h
@@ -40,6 +40,7 @@ struct hexagonfs_file_ops {
 		      struct hexagonfs_fd **out);
 	int (*readdir)(struct hexagonfs_fd *fd, size_t size, char *out);
 	ssize_t (*read)(struct hexagonfs_fd *fd, size_t size, void *ptr);
+	ssize_t (*write)(struct hexagonfs_fd *fd, size_t size, const void *ptr);
 	int (*stat)(struct hexagonfs_fd *fd, struct stat *stats);
 	int (*seek)(struct hexagonfs_fd *fd, off_t off, int whence);
 };
@@ -65,6 +66,7 @@ struct hexagonfs_fd {
 
 extern struct hexagonfs_file_ops hexagonfs_mapped_ops;
 extern struct hexagonfs_file_ops hexagonfs_mapped_or_empty_ops;
+extern struct hexagonfs_file_ops hexagonfs_mapped_rw_ops;
 extern struct hexagonfs_file_ops hexagonfs_mapped_sysfs_ops;
 extern struct hexagonfs_file_ops hexagonfs_plat_subtype_name_ops;
 extern struct hexagonfs_file_ops hexagonfs_virt_dir_ops;
@@ -77,5 +79,6 @@ int hexagonfs_fstat(struct hexagonfs_fd **fds, int fileno, struct stat *stats);
 int hexagonfs_lseek(struct hexagonfs_fd **fds, int fileno, off_t pos, int whence);
 int hexagonfs_readdir(struct hexagonfs_fd **fds, int fileno, size_t size, char *name);
 ssize_t hexagonfs_read(struct hexagonfs_fd **fds, int fileno, size_t size, void *ptr);
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr);
 
 #endif
diff --git a/hexagonrpcd/hexagonfs_mapped.c b/hexagonrpcd/hexagonfs_mapped.c
index fd28c8c..3ade7b3 100644
--- a/hexagonrpcd/hexagonfs_mapped.c
+++ b/hexagonrpcd/hexagonfs_mapped.c
@@ -322,6 +322,74 @@ static int mapped_sysfs_stat(struct hexagonfs_fd *fd, struct stat *stats)
 	return 0;
 }
 
+/*
+ * Writable variant of the mapped file operations.
+ *
+ * The DSP file service is read-only by design; the only writable entry in
+ * the tree is the sensor registry temp.json scratch file, which the sensor
+ * PD rebuilds on every initialization (on stock this lives on the persist
+ * partition). Serving it for real stops the PD's bounded open-for-writing
+ * retry storm without granting the DSP any other write surface: a write
+ * open only succeeds when it resolves to a dirent constructed with these
+ * operations, and fwrite is only served on fds carrying them.
+ */
+static int mapped_rw_from_dirent(const void *dirent_data, bool dir, void **fd_data)
+{
+	struct mapped_ctx *ctx;
+	const char *name = dirent_data;
+	int ret;
+
+	if (dir)
+		return -EISDIR;
+
+	ctx = malloc(sizeof(struct mapped_ctx));
+	if (ctx == NULL)
+		return -ENOMEM;
+
+	ctx->fd = open(name, O_RDWR | O_CREAT | O_TRUNC, 0644);
+	if (ctx->fd == -1) {
+		ret = -errno;
+		free(ctx);
+		return ret;
+	}
+
+	ctx->dir = NULL;
+
+	*fd_data = ctx;
+
+	return 0;
+}
+
+static ssize_t mapped_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	ssize_t ret;
+
+	ret = write(ctx->fd, ptr, size);
+	if (ret < 0)
+		return -errno;
+
+	return ret;
+}
+
+/*
+ * Report the write bit so the sensor framework treats the file as a
+ * writable scratch file instead of failing its own access check.
+ */
+static int mapped_rw_stat(struct hexagonfs_fd *fd, struct stat *stats)
+{
+	int ret;
+
+	ret = mapped_stat(fd, stats);
+	if (ret)
+		return ret;
+
+	if (!(stats->st_mode & S_IFDIR))
+		stats->st_mode |= S_IWUSR;
+
+	return 0;
+}
+
 struct hexagonfs_file_ops hexagonfs_mapped_ops = {
 	.close = mapped_close,
 	.from_dirent = mapped_from_dirent,
@@ -332,6 +400,17 @@ struct hexagonfs_file_ops hexagonfs_mapped_ops = {
 	.stat = mapped_stat,
 };
 
+struct hexagonfs_file_ops hexagonfs_mapped_rw_ops = {
+	.close = mapped_close,
+	.from_dirent = mapped_rw_from_dirent,
+	.openat = mapped_openat,
+	.read = mapped_read,
+	.write = mapped_write,
+	.readdir = NULL,
+	.seek = mapped_seek,
+	.stat = mapped_rw_stat,
+};
+
 struct hexagonfs_file_ops hexagonfs_mapped_or_empty_ops = {
 	.close = mapped_or_empty_close,
 	.from_dirent = mapped_or_empty_from_dirent,
diff --git a/hexagonrpcd/interfaces/apps_std.def b/hexagonrpcd/interfaces/apps_std.def
index 2fbbdb1..d9f7cca 100644
--- a/hexagonrpcd/interfaces/apps_std.def
+++ b/hexagonrpcd/interfaces/apps_std.def
@@ -28,6 +28,7 @@ HEXAGONRPC_DEFINE_REMOTE_METHOD(1, apps_std_freopen, 1, 0, 1, 1)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(2, apps_std_fflush, 8, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(3, apps_std_fclose, 1, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(4, apps_std_fread, 1, 0, 2, 1)
+HEXAGONRPC_DEFINE_REMOTE_METHOD(5, apps_std_fwrite, 1, 1, 1, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(9, apps_std_fseek, 3, 0, 0, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(19, apps_std_fopen_with_env, 0, 4, 1, 0)
 HEXAGONRPC_DEFINE_REMOTE_METHOD(26, apps_std_opendir, 0, 1, 2, 0)
diff --git a/hexagonrpcd/rpcd_builder.c b/hexagonrpcd/rpcd_builder.c
index cbe68da..4e2a76c 100644
--- a/hexagonrpcd/rpcd_builder.c
+++ b/hexagonrpcd/rpcd_builder.c
@@ -33,6 +33,7 @@
 #define SNS_REG_VERSION		"/sensors/sns_reg_version"
 #define SNS_REG_CONFIG		"/sensors/sns_reg.conf"
 #define SYSFS_SOCINFO		"/socinfo/"
+#define SENSORS_TEMPJSON	"/mnt/vendor/persist/sensors/registry/temp.json"
 
 /*
  * Vendor DSP file tree aliases: Android mounts the dsp partition at
@@ -98,6 +99,23 @@ static struct hexagonfs_dirent *hfs_map(const char *name, const char *path)
 	return file;
 }
 
+/* Writable mapped file: the only such entry is the sensor registry
+ * temp.json scratch file; see hexagonfs_mapped.c for the semantics. */
+static struct hexagonfs_dirent *hfs_map_rw(const char *name, const char *path)
+{
+	struct hexagonfs_dirent *file;
+
+	file = malloc(sizeof(struct hexagonfs_dirent));
+	if (file == NULL)
+		return NULL;
+
+	file->name = name;
+	file->ops = &hexagonfs_mapped_rw_ops;
+	file->u.phys = path;
+
+	return file;
+}
+
 static struct hexagonfs_dirent *hfs_map_or_empty(const char *name, const char *path)
 {
 	struct hexagonfs_dirent *file;
@@ -121,7 +139,7 @@ static struct hexagonfs_dirent *hfs_map_or_empty(const char *name, const char *p
 struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 {
 	char *acdbdata, *dsp_dir, *dsp_libs, *sns_cfg, *sns_reg, *sns_reg_version,
-	     *sns_reg_config, *socinfo;
+	     *sns_reg_config, *socinfo, *tempjson;
 	size_t n_prefix;
 	struct hexagonfs_dirent *persist_dir, *vendor_dir;
 
@@ -133,6 +151,7 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 	sns_reg_version = malloc(n_prefix + strlen(SNS_REG_VERSION) + 1);
 	sns_reg_config = malloc(n_prefix + strlen(SNS_REG_CONFIG) + 1);
 	socinfo = malloc(n_prefix + strlen(SYSFS_SOCINFO) + 1);
+	tempjson = malloc(n_prefix + strlen(SENSORS_TEMPJSON) + 1);
 
 	dsp_libs = malloc(n_prefix + strlen(DSP_LIBS) + strlen(dsp) + 1);
 	dsp_dir = malloc(n_prefix + strlen(DSP_LIBS) + 1);
@@ -152,6 +171,11 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 		strcat(sns_reg, SENSORS_REGISTRY);
 	}
 
+	if (tempjson != NULL) {
+		strcpy(tempjson, prefix);
+		strcat(tempjson, SENSORS_TEMPJSON);
+	}
+
 	if (sns_reg_version != NULL) {
 		strcpy(sns_reg_version, prefix);
 		strcat(sns_reg_version, SNS_REG_VERSION);
@@ -184,9 +208,10 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 	 */
 	persist_dir = hfs_mkdir("persist", 1,
 				hfs_mkdir("sensors", 1,
-					hfs_mkdir("registry", 2,
+					hfs_mkdir("registry", 3,
 						hfs_map("registry", sns_reg),
-						hfs_map("sns_reg_version", sns_reg_version)
+						hfs_map("sns_reg_version", sns_reg_version),
+						hfs_map_rw("temp.json", tempjson)
 					)
 				)
 		      );
-- 
