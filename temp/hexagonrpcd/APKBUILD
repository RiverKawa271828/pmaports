# Forked from Alpine community (0.4.0-r3) for the Meizu 20 SPF audio
# front (A2a): hexagonrpcd gains a -P option that creates a named static
# PD (INIT_CREATE_STATIC, audiopd, 3MB remote heap) and serves that
# user-PD session, replicating Android's audioadsprpcd. Adds the vendor
# DSP file tree aliases (/vendor/dsp, /data/vendor/audio_dsp -> <root>/dsp)
# and the hexagonrpcd-adsp-audiopd.service unit (NOT enabled - start
# manually, see the unit for the crash-history rationale).
# r45 (pkgrel 5): -m / HEXAGONRPCD_MEMLEN heap-size knob for the 12MB
# single-variable audiopd test (0002 patch).
# r5b (pkgrel 6): official audiopd session shape (0003 patch): keep
# adsp_default_listener open + method-1 pump thread (geteventfd has no
# mainline substrate), apps_std ENOENT whitelist for oemconfig.so /
# librpcversion_skel.so.
# r7 (sensors front 2026-10-03): 0004 = SSC registry version sibling
# mapping (ROM parent-traverses registry/../sns_reg_version); 0005 =
# narrow sns_registry property shim (method 0, two pinned property
# names, empty values) ported from the liuqin sm8475 sensors stack to
# the 0.4 interp2 dispatch. Serves the hexagonrpcd -s (INIT_ATTACH_SNS)
# sensors session on /dev/fastrpc-adsp (Meizu 20: sensor PD lives on
# ADSP, no SLPI remoteproc on kalama).
# Upstream candidate: linux-msm/hexagonrpc; local tree = meizu20/
# hexagonrpc-upstream (branch meizu20-audiopd).
# Rollback on device: apk add hexagonrpcd==0.4.0-r3 (Alpine repos).
maintainer="ri <ri@example.com>"
pkgname=hexagonrpcd
pkgver=0.4.0
pkgrel=7
pkgdesc="Qualcomm HexagonFS daemon"
url="https://github.com/linux-msm/hexagonrpc"
# s390x: fails on 1 test. Hexagonrpcd is specific to Qualcomm ARM SoCs, so let's ignore it for now.
arch="all !s390x"
license="GPL-3.0-or-later"
makedepends="linux-headers meson"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd $pkgname-udev"

	source="$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$pkgver.tar.gz
	10-fastrpc.rules
	$pkgname-adsp-rootpd.initd
	$pkgname-adsp-sensorspd.initd
	$pkgname-sdsp.initd
	$pkgname-adsp-audiopd.service
	systemd-services.patch
	0001-hexagonrpcd-add-P-option-to-create-and-serve-a-named.patch
	0002-hexagonrpcd-make-the-P-static-PD-heap-size-tunable-m.patch
	0003-hexagonrpcd-serve-static-PD-sessions-in-the-official.patch
	0004-hexagonrpcd-expose-the-SSC-registry-version-sibling.patch
	0005-hexagonrpcd-add-a-narrow-sns_registry-property-shim.patch
	"
builddir="$srcdir/hexagonrpc-$pkgver"

build() {
	abuild-meson -Db_lto=true . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# Allow access for FastRPC node for FastRPC user/group
	install -Dm644 "$srcdir"/10-fastrpc.rules -t "$pkgdir"/usr/lib/udev/rules.d/

	install -Dm755 "$srcdir"/$pkgname-adsp-rootpd.initd "$pkgdir"/etc/init.d/$pkgname-adsp-rootpd
	install -Dm755 "$srcdir"/$pkgname-adsp-sensorspd.initd "$pkgdir"/etc/init.d/$pkgname-adsp-sensorspd
	install -Dm755 "$srcdir"/$pkgname-sdsp.initd "$pkgdir"/etc/init.d/$pkgname-sdsp

	# audiopd session holder (Meizu 20): shipped disabled - the preset
	# files stay untouched, so nothing pulls it in at boot.
	install -Dm644 "$srcdir"/$pkgname-adsp-audiopd.service -t "$pkgdir"/usr/lib/systemd/system/
}


