From 6f07ca6af409d73d21382d9b036c1d06648f6516 Mon Sep 17 00:00:00 2001
From: ri <ri@localhost>
Date: Fri, 2 Oct 2026 03:25:11 +0800
Subject: [PATCH] hexagonrpcd: add -P option to create and serve a named static
 PD
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Meizu 20 (SM8550) SPF audio front, host round A2a. Replicates Android's
early-init daemon 'audioadsprpcd audiopd' on mainline userspace:

- rpcd: new -P PD option = INIT_CREATE_STATIC(name, memlen=3MB) then
  serve the user-PD session through the existing reverse tunnel
  (adsp_default_listener + apps_std + apps_mem). 3MB is the official
  audio PD remote heap size; on this firmware 1MB also completes and
  16MB ETIMEDOUTs (experiment-log 2026-10-01（七）).
- rpcd_builder: map the vendor DSP file tree aliases /vendor/dsp and
  /data/vendor/audio_dsp onto <root>/dsp so the audiopd dlopen requests
  resolve against the dsp partition content (SPF module libraries +
  fastrpc_shell_0) when it is mounted there.

Session verdict target (device round B2): does GET_SPF_STATE answer
once the audio PD has a session holder, un-breaking the
q6prm -> LPASS macros -> SoundWire -> wcd938x -> sound card cascade.
---
 hexagonrpcd/rpcd.c         | 57 +++++++++++++++++++++++++++++++++++++-
 hexagonrpcd/rpcd_builder.c | 28 ++++++++++++++++---
 2 files changed, 80 insertions(+), 5 deletions(-)

diff --git a/hexagonrpcd/rpcd.c b/hexagonrpcd/rpcd.c
index cc1f5cf..4239124 100644
--- a/hexagonrpcd/rpcd.c
+++ b/hexagonrpcd/rpcd.c
@@ -23,7 +23,9 @@
 #include <fcntl.h>
 #include <libhexagonrpc/fastrpc.h>
 #include <libhexagonrpc/interfaces/remotectl.def>
+#include <linux/types.h>
 #include <misc/fastrpc.h>
+#include <stdint.h>
 #include <unistd.h>
 #include <signal.h>
 #include <stdbool.h>
@@ -43,6 +45,27 @@
 #include "localctl.h"
 #include "rpcd_builder.h"
 
+/*
+ * Meizu 20 (SM8550) SPF audio: replicate Android's early-init daemon
+ * `audioadsprpcd audiopd` (vendor.qti.audio-adsprpc-service.rc): create
+ * the "audiopd" named static PD and serve its session (listener +
+ * apps_std + apps_mem). The 3MB heap size is the official audio PD
+ * remote heap (fastrpc_apps_user.c: "3MB of remote heap … only for
+ * Audio PD"); 1MB also completes, 16MB ETIMEDOUTs on this firmware.
+ */
+#define AUDIOPD_HEAP_SIZE 0x300000
+
+#ifndef FASTRPC_IOCTL_INIT_CREATE_STATIC
+/* Older uapi headers predate static PD support (added in v6.6). */
+struct fastrpc_init_create_static {
+	__u32 namelen;
+	__u32 memlen;
+	__u64 name;
+};
+#define FASTRPC_IOCTL_INIT_CREATE_STATIC \
+	_IOWR('R', 9, struct fastrpc_init_create_static)
+#endif
+
 static int remotectl_open(int fd, char *name, struct fastrpc_context **ctx, void (*err_cb)(const char *err))
 {
 	uint32_t handle;
@@ -139,6 +162,7 @@ static void print_usage(const char *argv0)
 	       "\t-d DSP\t\tDSP name (default: "")\n"
 	       "\t-f DEVICE\tFastRPC device node to attach to\n"
 	       "\t-p PROGRAM\tRun client program with shared file descriptor\n"
+	       "\t-P PD\t\tCreate the named static PD (e.g. audiopd) and serve it\n"
 	       "\t-R DIR\t\tRoot directory of served files (default: /usr/share/qcom/)\n"
 	       "\t-s\t\tAttach to sensorspd\n");
 }
@@ -197,6 +221,23 @@ err_close_fd:
 	return ret;
 }
 
+static int create_static_pd(int fd, const char *name)
+{
+	struct fastrpc_init_create_static init = {
+		.namelen = (uint32_t)(strlen(name) + 1),
+		.memlen = AUDIOPD_HEAP_SIZE,
+		.name = (uint64_t)(uintptr_t)name,
+	};
+	int ret;
+
+	ret = ioctl(fd, FASTRPC_IOCTL_INIT_CREATE_STATIC, &init);
+	if (ret)
+		fprintf(stderr, "INIT_CREATE_STATIC(%s): %s\n",
+			name, strerror(errno));
+
+	return ret;
+}
+
 static int setup_environment(int fd)
 {
 	char *buf;
@@ -412,6 +453,7 @@ int main(int argc, char* argv[])
 	const char *device_dir = "/usr/share/qcom/";
 	const char *dsp = "";
 	const char *create_shell = NULL;
+	const char *static_pd = NULL;
 	const char *guessed_device_dir;
 	const char **progs;
 	pid_t *pids;
@@ -435,7 +477,7 @@ int main(int argc, char* argv[])
 	if (guessed_device_dir != NULL)
 		device_dir = guessed_device_dir;
 
-	while ((opt = getopt(argc, argv, "c:d:f:p:R:s")) != -1) {
+	while ((opt = getopt(argc, argv, "c:d:f:p:P:R:s")) != -1) {
 		switch (opt) {
 			case 'c':
 				create_shell = optarg;
@@ -450,6 +492,9 @@ int main(int argc, char* argv[])
 				progs[n_progs] = optarg;
 				n_progs++;
 				break;
+			case 'P':
+				static_pd = optarg;
+				break;
 			case 'R':
 				device_dir = optarg;
 				break;
@@ -467,6 +512,11 @@ int main(int argc, char* argv[])
 		goto err_free_pids;
 	}
 
+	if (static_pd != NULL && (attach_sns || create_shell != NULL)) {
+		fprintf(stderr, "-P cannot be combined with -s or -c\n");
+		goto err_free_pids;
+	}
+
 	printf("Starting %s (%s) on %s\n", argv[0], attach_sns? "INIT_ATTACH_SNS": "INIT_ATTACH", fastrpc_node);
 
 	fd = open(fastrpc_node, O_RDWR);
@@ -477,6 +527,11 @@ int main(int argc, char* argv[])
 
 	if (attach_sns)
 		ret = ioctl(fd, FASTRPC_IOCTL_INIT_ATTACH_SNS, NULL);
+	else if (static_pd != NULL) {
+		printf("Creating static PD \"%s\" (remote heap %d bytes)\n",
+		       static_pd, AUDIOPD_HEAP_SIZE);
+		ret = create_static_pd(fd, static_pd);
+	}
 	else if (create_shell != NULL)
 		ret = create_shell_pd(fd, create_shell);
 	else
diff --git a/hexagonrpcd/rpcd_builder.c b/hexagonrpcd/rpcd_builder.c
index d374958..2582669 100644
--- a/hexagonrpcd/rpcd_builder.c
+++ b/hexagonrpcd/rpcd_builder.c
@@ -33,6 +33,14 @@
 #define SNS_REG_CONFIG		"/sensors/sns_reg.conf"
 #define SYSFS_SOCINFO		"/socinfo/"
 
+/*
+ * Vendor DSP file tree aliases: Android mounts the dsp partition at
+ * /vendor/dsp (subdirs adsp/, cdsp/) and points DSP_LIBRARY_PATH of the
+ * audio PD daemon at /data/vendor/audio_dsp. Both are mapped onto
+ * <root>/dsp (e.g. /mnt/dsp with the dsp partition mounted there), in
+ * addition to the Linux-convention /usr/lib/qcom/<dsp> below.
+ */
+
 static struct hexagonfs_dirent *hfs_mkdir(const char *name, size_t n_ents, ...)
 {
 	struct hexagonfs_dirent *dir;
@@ -111,7 +119,7 @@ static struct hexagonfs_dirent *hfs_map_or_empty(const char *name, const char *p
  */
 struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 {
-	char *acdbdata, *dsp_libs, *sns_cfg, *sns_reg, *sns_reg_config, *socinfo;
+	char *acdbdata, *dsp_dir, *dsp_libs, *sns_cfg, *sns_reg, *sns_reg_config, *socinfo;
 	size_t n_prefix;
 	struct hexagonfs_dirent *persist_dir, *vendor_dir;
 
@@ -124,6 +132,7 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 	socinfo = malloc(n_prefix + strlen(SYSFS_SOCINFO) + 1);
 
 	dsp_libs = malloc(n_prefix + strlen(DSP_LIBS) + strlen(dsp) + 1);
+	dsp_dir = malloc(n_prefix + strlen(DSP_LIBS) + 1);
 
 	if (acdbdata != NULL) {
 		strcpy(acdbdata, prefix);
@@ -156,6 +165,11 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 		strcat(dsp_libs, dsp);
 	}
 
+	if (dsp_dir != NULL) {
+		strcpy(dsp_dir, prefix);
+		strcat(dsp_dir, "/dsp");
+	}
+
 	/*
 	 * Some platforms need this in / and some need it in /mnt/vendor. Form
 	 * a hard link between both locations.
@@ -172,17 +186,23 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 	 * Some platforms need vendor in / and some need it in /system. Form
 	 * a hard link between both locations.
 	 */
-	vendor_dir = hfs_mkdir("vendor", 1,
+	vendor_dir = hfs_mkdir("vendor", 2,
 				hfs_mkdir("etc", 2,
 					hfs_mkdir("sensors", 2,
 						hfs_map_or_empty("config", sns_cfg),
 						hfs_map("sns_reg_config", sns_reg_config)
 					),
 					hfs_map("acdbdata", acdbdata)
-				)
+				),
+				hfs_map_or_empty("dsp", dsp_dir)
 			);
 
-	return hfs_mkdir("/", 6,
+	return hfs_mkdir("/", 7,
+			hfs_mkdir("data", 1,
+				hfs_mkdir("vendor", 1,
+					hfs_map_or_empty("audio_dsp", dsp_dir)
+				)
+			),
 			hfs_mkdir("mnt", 1,
 				hfs_mkdir("vendor", 1,
 					persist_dir
-- 
2.43.0

