+static int boe_meizu20_session_probe_show(struct seq_file *m, void *v)
+{
+	struct boe_meizu20 *ctx = m->private;
+
+	if (!ctx->snap_probe_len) {
+		seq_puts(m, "(no probe-time snapshot yet)\n");
