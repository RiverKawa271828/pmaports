+	ok = boe_meizu20_capture(ctx, &ctx->snap_now, &ctx->snap_now_len,
+				 "full", true);
+	mutex_unlock(&ctx->diag_lock);
+
+	dev_info(&ctx->dsi->dev, "r22: full sweep snapshot (ok=%d)\n", ok);
