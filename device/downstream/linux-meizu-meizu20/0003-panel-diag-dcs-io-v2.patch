+/* DIAGNOSTIC (M1 probe): read an arbitrary DCS register in LP mode (HS reads
+ * come back -ENODATA on this host) and dump it, so the DDIC's live picture
+ * parameter set (0xA2/0xA9 candidates) can be compared between the never-
+ * power-cycled ("good") state and the after-power-cycle ("bad") state. */
+static int boe_meizu20_dcs_read_reg(struct boe_meizu20 *ctx, u8 off)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned long mode_flags = dsi->mode_flags;
+	int ret, i;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_read(dsi, off, ctx->rd_buf, sizeof(ctx->rd_buf));
+	dsi->mode_flags = mode_flags;
+	if (ret < 0) {
+		dev_err(&dsi->dev, "M1 dcs_read 0x%02x: failed %d\n", off, ret);
+		return ret;
+	}
+
+	ctx->rd_off = off;
+	ctx->rd_len = ret;
+	dev_info(&dsi->dev, "M1 dcs_read 0x%02x: len=%d:", off, ret);
+	for (i = 0; i < ret; i++)
+		pr_cont("%s%02x", i ? " " : " ", ctx->rd_buf[i]);
+	pr_cont("\n");
+	return ret;
+}
+
+static ssize_t boe_meizu20_dcs_read_write(struct file *file,
+					  const char __user *ubuf,
+					  size_t count, loff_t *ppos)
+{
+	struct boe_meizu20 *ctx = file_inode(file)->i_private;
+	char kbuf[8];
+	u8 off;
+	int ret;
+
+	if (!count || count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, ubuf, count))
+		return -EFAULT;
+	kbuf[count] = '\0';
+	ret = kstrtou8(strstrip(kbuf), 0, &off);
+	if (ret)
+		return ret;
+
+	ret = boe_meizu20_dcs_read_reg(ctx, off);
+	return ret < 0 ? ret : count;
+}
+
+static int boe_meizu20_dcs_read_show(struct seq_file *m, void *v)
+{
+	struct boe_meizu20 *ctx = m->private;
+	int i;
+
+	if (ctx->rd_len <= 0) {
+		seq_puts(m, "(no read yet; echo 0xa2 > dcs_read)\n");
+		return 0;
+	}
+	seq_printf(m, "dcs 0x%02x len=%d:", ctx->rd_off, ctx->rd_len);
+	for (i = 0; i < ctx->rd_len; i++)
+		seq_printf(m, " %02x", ctx->rd_buf[i]);
+	seq_putc(m, '\n');
+	return 0;
+}
+
+/* DIAGNOSTIC (M1 probe v2): send an arbitrary DCS packet in LP mode.
+ * Input = hex bytes, first byte = DCS register, rest = payload, e.g.:
+ *   echo "f0 55 aa 52 08 01" > dcs_write   (vendor page select)
+ *   echo "a0 <128 PPS bytes>" > dcs_write  (standard Write_PPS, capability test)
+ * Returns host status; pair with dcs_read to check whether the DDIC really
+ * implements standard PPS read/write (icna35xx precedent: some do not). */
+static ssize_t boe_meizu20_dcs_write_write(struct file *file,
+					   const char __user *ubuf,
+					   size_t count, loff_t *ppos)
+{
+	struct boe_meizu20 *ctx = file_inode(file)->i_private;
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned long mode_flags = dsi->mode_flags;
+	u8 payload[128];
+	char *kbuf, *tok, *p;
+	u8 reg = 0;
+	int plen = 0, ret;
+
+	if (!count || count > 600)
+		return -EINVAL;
+	kbuf = memdup_user_nul(ubuf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+
+	p = strstrip(kbuf);
+	while ((tok = strsep(&p, " \t,")) != NULL) {
+		if (!*tok)
+			continue;
+		if (plen == 0) {
+			if (kstrtou8(tok, 16, &reg))
+				goto out_free;
+		} else {
+			if (plen > (int)sizeof(payload))
+				goto out_free;
+			if (kstrtou8(tok, 16, &payload[plen - 1]))
+				goto out_free;
+		}
+		plen++;
+	}
+	if (plen == 0)
+		goto out_free;
+	plen--; /* first token = register */
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_write(dsi, (u8)reg, plen ? payload : NULL, plen);
+	dsi->mode_flags = mode_flags;
+	if (ret < 0)
+		dev_err(&dsi->dev, "M1 dcs_write 0x%02x len=%d: failed %d\n",
+			reg, plen, ret);
+	else
+		dev_info(&dsi->dev, "M1 dcs_write 0x%02x len=%d: ok\n",
+			 reg, plen);
+	kfree(kbuf);
+	return ret < 0 ? ret : count;
+
+out_free:
+	kfree(kbuf);
+	return -EINVAL;
+}
+
+static const struct file_operations boe_meizu20_dcs_write_fops = {
+	.owner = THIS_MODULE,
+	.write = boe_meizu20_dcs_write_write,
+};
+
+/* DIAGNOSTIC: dump the last packed PPS the driver actually transmits. */
+static int boe_meizu20_pps_show(struct seq_file *m, void *v)
+{
+	struct boe_meizu20 *ctx = m->private;
+	int i;
+
+	if (!ctx->pps_valid) {
+		seq_puts(m, "(no PPS packed yet)\n");
+		return 0;
+	}
+	for (i = 0; i < (int)sizeof(ctx->pps_buf); i++)
+		seq_printf(m, "%02x%s", ctx->pps_buf[i],
+			   (i % 16 == 15) ? "\n" : " ");
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(boe_meizu20_pps);
+
+/* DIAGNOSTIC: re-send the packed PPS in LP mode.  Hypothesis under test:
+ * enable() transmits PPS in HS (no LPM in mode_flags); if the DDIC only
+ * latches PPS from LP packets (icna35xx family behaviour), an LP resend
+ * should instantly repair the post-power-cycle artifacts. */
+static ssize_t boe_meizu20_pps_resend_lp_write(struct file *file,
+					       const char __user *ubuf,
+					       size_t count, loff_t *ppos)
+{
+	struct boe_meizu20 *ctx = file_inode(file)->i_private;
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned long mode_flags = dsi->mode_flags;
+	int ret;
+
+	if (!ctx->pps_valid)
+		return -ENODATA;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_picture_parameter_set(dsi,
+			(const struct drm_dsc_picture_parameter_set *)ctx->pps_buf);
+	dsi->mode_flags = mode_flags;
+	if (ret < 0)
+		dev_err(&dsi->dev, "M1 pps_resend_lp: failed %d\n", ret);
+	else
+		dev_info(&dsi->dev, "M1 pps_resend_lp: ok (PPS re-sent in LP)\n");
+	return ret < 0 ? ret : count;
+}
+
+static const struct file_operations boe_meizu20_pps_resend_lp_fops = {
+	.owner = THIS_MODULE,
+	.write = boe_meizu20_pps_resend_lp_write,
+};
+
+/* DIAGNOSTIC: re-send compression-mode packet in LP with a selectable PPS
+ * profile (0-3, DSC 1.2 pre-stored profile selector).  XBL's panel DB pins
+ * DSIDSCProfileID=0xB for this panel, i.e. the bootloader selects a PROFILE
+ * instead of writing a PPS; after a power cycle our enable() always selects
+ * profile 0. */
+static ssize_t boe_meizu20_comp_sel_write(struct file *file,
+					  const char __user *ubuf,
+					  size_t count, loff_t *ppos)
+{
+	struct boe_meizu20 *ctx = file_inode(file)->i_private;
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned long mode_flags = dsi->mode_flags;
+	char kbuf[8];
+	u8 sel;
+	int ret;
+
+	if (!count || count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, ubuf, count))
+		return -EFAULT;
+	kbuf[count] = '\0';
+	if (kstrtou8(strstrip(kbuf), 0, &sel) || sel > 3)
+		return -EINVAL;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_compression_mode_ext(dsi, true, MIPI_DSI_COMPRESSION_DSC,
+					    sel);
+	dsi->mode_flags = mode_flags;
+	if (ret < 0)
+		dev_err(&dsi->dev, "M1 comp_sel %u: failed %d\n", sel, ret);
+	else
+		dev_info(&dsi->dev, "M1 comp_sel %u: ok (LP compression-mode, profile %u)\n",
+			 sel, sel);
+	return ret < 0 ? ret : count;
+}
+
+static const struct file_operations boe_meizu20_comp_sel_fops = {
+	.owner = THIS_MODULE,
+	.write = boe_meizu20_comp_sel_write,
+};
+
+/* DIAGNOSTIC: PPS + compression-mode, both in LP, selector 0 (the "both
+ * packets in LP" variant of the capability test). */
+static ssize_t boe_meizu20_pps_comp_lp_write(struct file *file,
+					     const char __user *ubuf,
+					     size_t count, loff_t *ppos)
+{
+	struct boe_meizu20 *ctx = file_inode(file)->i_private;
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	unsigned long mode_flags = dsi->mode_flags;
+	int ret;
+
+	if (!ctx->pps_valid)
+		return -ENODATA;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_picture_parameter_set(dsi,
+			(const struct drm_dsc_picture_parameter_set *)ctx->pps_buf);
+	if (ret < 0)
+		goto out;
+	ret = mipi_dsi_compression_mode_ext(dsi, true, MIPI_DSI_COMPRESSION_DSC,
+					    0);
+out:
+	dsi->mode_flags = mode_flags;
+	if (ret < 0)
+		dev_err(&dsi->dev, "M1 pps_comp_lp: failed %d\n", ret);
+	else
+		dev_info(&dsi->dev, "M1 pps_comp_lp: ok (LP PPS + LP compression)\n");
+	return ret < 0 ? ret : count;
+}
+
+static const struct file_operations boe_meizu20_pps_comp_lp_fops = {
+	.owner = THIS_MODULE,
+	.write = boe_meizu20_pps_comp_lp_write,
+};
