4eed4d24452cd80ae7200ba797800d5b258e15040adada6ea2cb740ea1cc3484c01e4cffe6f53675a2ae180a23df3b2a98b6c9c361aafaaf4631c3a636b5d8a2  config-meizu-meizu20.aarch64
a2829face44e1e7bde41dd228aa58515f89b850b2bce347c01e2c69d913ccfeccd3ca0f21cd26a933d4e90393fcc05d897b52644151bce8131f5de992c89e5cf  0001-arm64-dts-qcom-add-Meizu-20-m2381-device-tree.patch
