# Maintainer: nura-meizu-m2381 <dev@nura-meizu-m2381.invalid>
# Status LED ring effects for Meizu 20 (dual SY7808 ring flash, 6 lamps).
# Modular C engine: one effect = src/eff_<name>.c + one line in src/effects.c.
# Canonical dev tree: nura repo tools/status-led/ringlight/ (keep byte-identical,
# device-meizu-meizu20 r4 overlay-sync convention).
pkgname=meizu20-tools
pkgver=0.2.0
pkgrel=6
pkgdesc="Meizu 20 toolbox: LED ring effects (chase/flow/breath) + boot animation + GUI"
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !pmb:crossdirect"
makedepends="qt6-qtbase-dev qt6-qtdeclarative-dev"
source="
	50-ringlight.rules
	80-ringlight.preset
	ringlight-boot.service
	meizu20-tools.desktop
	ringlight.conf
	org.meizu20.tools.policy
	led-helper
"
# abuild "cleans" $srcdir between phases; with no real sources it defaults to
# $startdir/src and would delete the bundled C tree. Redirect both to a
# dedicated scratch dir (unpacks the source= files there; C tree untouched).
srcdir="$startdir/abuild-scratch"
builddir="$srcdir"

build() {
	# compile in-place (never copy the tree), binaries emitted to the scratch dir
	make -C "$startdir" BIN="$builddir/ringlight"
	/usr/lib/qt6/libexec/moc "$startdir/gui/main.cpp" -o "$builddir/main.moc"
	g++ -O2 $CXXFLAGS -I"$builddir" "$startdir/gui/main.cpp" \
		-o "$builddir/ringlight-gui" \
		$(pkg-config --cflags --libs Qt6Quick Qt6Qml)
}

package() {
	install -Dm755 "$builddir"/ringlight \
		"$pkgdir"/usr/bin/ringlight
	install -Dm755 "$builddir"/ringlight-gui \
		"$pkgdir"/usr/bin/ringlight-gui
	install -Dm644 "$startdir"/gui/RingLight.qml \
		"$pkgdir"/usr/share/ringlight/RingLight.qml
	install -Dm644 "$srcdir"/ringlight-boot.service \
		"$pkgdir"/usr/lib/systemd/system/ringlight-boot.service
	install -Dm644 "$srcdir"/80-ringlight.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-ringlight.preset
	install -Dm644 "$srcdir"/meizu20-tools.desktop \
		"$pkgdir"/usr/share/applications/meizu20-tools.desktop
	install -Dm644 "$srcdir"/ringlight.conf \
		"$pkgdir"/usr/lib/tmpfiles.d/ringlight.conf
	install -Dm644 "$srcdir"/50-ringlight.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/50-ringlight.rules
	install -Dm644 "$srcdir"/org.meizu20.tools.policy \
		"$pkgdir"/usr/share/polkit-1/actions/org.meizu20.tools.policy
	install -Dm755 "$srcdir"/led-helper \
		"$pkgdir"/usr/lib/ringlight/led-helper
}

