<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <!-- Meizu20-Tools LED ring: arm the boot animation / master off.
       Scoped to exactly one program (the pkexec helper) so it never
       broadens systemd unit management. auth_admin = password prompt
       EVERY time (no keep-cache) — both directions must confirm. -->
  <action id="org.meizu20.tools.led-control">
    <description>Change Meizu20 LED ring settings</description>
    <message>Authentication is required to change the LED ring settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ringlight/led-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</allow_gui>
  </action>

</policyconfig>
