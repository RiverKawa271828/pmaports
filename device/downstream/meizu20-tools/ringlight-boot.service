[Unit]
Description=RingLight status LED boot animation (SY7808 ring flash)
After=multi-user.target

[Service]
Type=simple
# leds_sy7808 owns the i2c client via leds class; raw i2c needs it gone.
# Retry: at multi-user the module may still be mid-autoload.
ExecStartPre=/bin/sh -c 'for i in 1 2 3 4 5; do rmmod leds_sy7808 2>/dev/null && break; sleep 0.5; done; exit 0'
ExecStart=/usr/bin/ringlight boot
# Always reload the driver on ANY exit (incl. RuntimeMaxSec kill):
# probe re-initializes registers -> torch/strobe fully back, lamps off.
ExecStopPost=/bin/sh -c 'modprobe leds_sy7808 2>/dev/null; exit 0'
RuntimeMaxSec=600
Restart=no

[Install]
WantedBy=multi-user.target
