# feedbackd only probes input devices carrying FEEDBACKD_TYPE=vibra
# (fbd-feedback-manager.c FEEDBACKD_UDEV_ATTR); the feedbackd package's
# 72-feedbackd.rules covers other drivers but not our aw8697 input name.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT}=="1", SUBSYSTEMS=="input", ATTRS{name}=="aw8697-haptics", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"
