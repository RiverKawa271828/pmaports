enable qbootctl-meizu.service
enable meizu-touch.service
enable meizu-amps.service
# r11: audio chain starts MANUAL only - default boot must be silent (SWR
# CLASH unresolved; the old per-rootfs fuse dance is replaced by this
# disable). Audio device days: systemctl start meizu-audio.service.
disable meizu-audio.service
enable meizu-retimer.service
enable meizu-pas.service
enable meizu-quiet.service
enable meizu-memsleep.service
enable meizu-wfi.service
enable meizu-noswr.service
enable meizu-grow-rootfs.service
# r13: read-only dsp mount feeding the audiopd file service (the audiopd
# daemon itself stays manual - see temp/hexagonrpcd unit).
enable meizu-dsp-mount.service
enable devshell.service
# r16: sensors readiness gate (waits for the SSC QRTR service, then
# re-announces iio-sensor-proxy - boot scan races the sensors PD).
enable meizu-sensors-ready.service
# r21: accel-ready barrier (graphical transaction) - kwin never
# re-claims SensorProxy, so the session must not start before the
# accelerometer exists (rotation QS tile, 2026-10-04).
enable meizu-sensors-barrier.service
# r20: brightness clamp guard timer (kernel floor is the primary fix,
# this bounces sub-floor writes userspace-side within 2s).
# r38: RETIRED - double-obsolete since r55 ((六十五·续2)): the kernel
# driver floor BL_MIN_BRIGHTNESS=15 clamps at driver level (sub-15 writes
# never reach the panel), and this script still bounces to the r20-era 50,
# kicking the legal 15..49 range (S2 calibration) back to 50. The kernel
# floor IS the guard now; unit files stay shipped for manual experiments.
# r22: bind the boot-orphan SEs (a80000 NFC + 994000 haptics) every boot.
enable meizu-bind-nfc-haptics.service
# audio device day 2026-10-04 (T4c): udev never probes the sound platform
# device (of modalias T(null)) - idempotent machine-driver bind floor.
enable meizu-sndcard-bind.service
# audio daily round 2026-10-04 (S1): pin playback routing to the T4c
# operating point every boot (FE MultiMedia1 -> SEC_MI2S -> CS35L45 x2,
# safe volumes, amps on). Pure userspace; opens no PCM device.
enable meizu-audio-route.service
