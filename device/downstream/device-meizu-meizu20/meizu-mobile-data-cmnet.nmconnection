# r78: 移动卡（4600）数据 profile —— APN cmnet。autoconnect=false 同 cbnet 件
# （理由见该文件头注释）。双卡切换（cell-switch）后数据面仍走 mm-dial 重拨；
# 本 profile 供 UI 显式激活/编辑用。
[connection]
id=meizu-mobile-data-cmnet
uuid=66605443-662a-462b-91f7-96f76e4d4197
type=gsm
autoconnect=false

[gsm]
apn=cmnet

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=disabled

[proxy]
