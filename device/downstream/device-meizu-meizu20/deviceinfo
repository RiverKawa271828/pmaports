deviceinfo_format_version="0"
deviceinfo_name="Meizu 20"
deviceinfo_manufacturer="Meizu"
deviceinfo_codename="meizu20"
deviceinfo_year="2023"
deviceinfo_dtb="qcom/sm8550-meizu-20"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2400"

# Bootloader related
# XBL -> ABL -> Mu-Silicium chainload (boot_b) -> bare-jump mainline
# Image; root on userdata (sda22). boot_b is assembled outside pmOS
# (ramdisk field = raw Image, dtb field = DTB, MZSF stamp @0x800), so
# no pmOS boot.img generation: flash_method stays "none" and flashing
# is manual fastboot (sandbox), rootfs image goes to userdata.
deviceinfo_flash_method="none"
deviceinfo_flash_pagesize="4096"
deviceinfo_rootfs_image_sector_size="4096"
# r38: zramstart defaults to zstd, but the zram module builds its algorithm
# table at module-init from what is loadable THEN - zstd (=m) is not in the
# table on first boot, so zramctl fails "Invalid argument" and
# postmarketos-zram-swap dies (found 2026-10-06, (六十五·续)). lzo-rle IS in
# the table and is the kernel default anyway.
deviceinfo_zram_swap_algo="lzo-rle"
