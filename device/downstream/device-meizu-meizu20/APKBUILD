build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir/modprobe.conf" \
		"$pkgdir"/etc/modprobe.d/50-meizu20-blacklist.conf
	# r59: uinput for Steam Input virtual gamepads (see r59 note above).
	# Rule numbering: 60 < systemd 70-uaccess.rules - the TAG must be set
	# before systemd's rule consumes it. modules-load.d gives the module a
	# boot-time load (misc has no open-autoload).
	install -Dm644 "$srcdir/60-meizu20-uinput.rules" \
		"$pkgdir"/usr/lib/udev/rules.d/60-meizu20-uinput.rules
	install -Dm644 "$srcdir/meizu20-uinput.conf" \
		"$pkgdir"/usr/lib/modules-load.d/meizu20-uinput.conf
	install -Dm755 "$srcdir/meizu-touch-load.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-touch-load.sh
	# r8: i2c10/888000 amp bind (CS35L45 x2), meizu-amps.service.
	install -Dm755 "$srcdir/meizu-amps-load.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-amps-load.sh
	# r9: ordered WCD9385 SWR chain bring-up (autoload never probes),
	# meizu-audio.service.
	install -Dm755 "$srcdir/meizu-audio-load.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-audio-load.sh
	# r7: 988000 (i2c_hub_2) safe-bind helper (whitelist candidate, U3
	# round 2026-09-30); unitized by r8 meizu-retimer.service.
	# 880000 stays lethal.
	install -Dm755 "$srcdir/meizu-bind-988000.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-bind-988000.sh
	for u in qbootctl-meizu meizu-touch meizu-amps meizu-audio meizu-retimer \
		meizu-noswr meizu-quiet meizu-memsleep meizu-grow-rootfs \
		meizu-wowlan meizu-dsp-mount devshell meizu-sndcard-bind meizu-audio-route; do
		install -Dm644 "$srcdir/$u.service" \
			"$pkgdir"/usr/lib/systemd/system/$u.service
	done
	# r13: active-slot dsp partition mounted ro at /mnt/dsp (audiopd file
	# service root).
	install -Dm755 "$srcdir/meizu-dsp-mount.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-dsp-mount.sh
	# r54: sleep-target masking (tmpfiles rule) REMOVED —— 睡眠死因已于内核侧
	# 修好（in-tree printk 的 console_suspend_all 回归 ⇒ cmdline no_console_suspend，
	# 见 nura AGENTS「suspend 已结案」）。新装镜像 = 睡眠可用、自动睡眠按桌面默认开。
	install -Dm644 "$srcdir/80-device-meizu-meizu20.preset" \
		"$pkgdir"/usr/lib/systemd/system-preset/80-device-meizu-meizu20.preset
	# r58: s2idle 长睡误杀 systemd 服务看门狗（s2idle 跳过 syscore ⇒ monotonic 照走，
	# 睡眠时长被计入 3min 看门狗）⇒ logind/udevd 被杀丢会话设备接管 = 用户面
	# 「屏黑+无输入」。会话关键二者关闭看门狗；内部服务放宽 30min。详见两文件头注释。
	for u in systemd-udevd systemd-logind; do
		install -Dm644 "$srcdir/10-meizu-no-watchdog.conf" \
			"$pkgdir"/usr/lib/systemd/system/$u.service.d/10-meizu-no-watchdog.conf
	done
	# 本机所有带 WatchdogSec 的 systemd 内部服务（枚举 2026-10-09）——被误杀不破坏
	# 会话但会刷 journal，统一放宽 30min；udevd/logind 见上（关闭）。
	for u in systemd-journald systemd-resolved systemd-timesyncd systemd-coredumpd \
		systemd-hostnamed systemd-importd systemd-localed systemd-machined \
		systemd-portabled systemd-sysupdated systemd-timedated systemd-oomd \
		systemd-mountfsd systemd-nsresourced; do
		install -Dm644 "$srcdir/10-meizu-watchdog-relax.conf" \
			"$pkgdir"/usr/lib/systemd/system/$u.service.d/10-meizu-watchdog-relax.conf
	done
	# r58: journald 落盘间隔 5min→30s（hard-reset 取证盲区收窄）。
	install -Dm644 "$srcdir/10-meizu-journald-sync.conf" \
		"$pkgdir"/usr/lib/systemd/journald.conf.d/10-meizu-journald-sync.conf
	# r9: udev trigger for the ADSP root-PD daemon session (the unit itself
	# ships later with the patched hexagonrpc; the want is inert until
	# then). A boot-time ConditionPathExists always evaluates before
	# /dev/fastrpc-adsp exists and skips forever - r38 device day note.
	install -Dm644 "$srcdir/71-meizu20-fastrpc-rootpd.rules" \
		"$pkgdir"/usr/lib/udev/rules.d/71-meizu20-fastrpc-rootpd.rules
	# r15: SSC sensors session (sensors round 2026-10-03). Kalama has no
	# SLPI remoteproc: sensor PD = adsps.jsn sensor_pd on the ADSP, served
	# via hexagonrpcd -s (INIT_ATTACH_SNS) from /dev/fastrpc-adsp, stock
	# form = /vendor/bin/sscrpcd sensorspd. The -R root carries the stock
	# sensor registry/calibration (persist harvest), kailua SEE config
	# JSONs (json.lst set) and socinfo placeholders; the dsp alias points
	# at /mnt/dsp (meizu-dsp-mount) for the DSP-side sns skel libraries
	# (libsns_dynamic_loader_skel.so et al) - without them the framework
	# never registers the sns_client QRTR service (0x190) and libssc finds
	# no sensors. udev trigger, not boot condition (rootpd r38 lesson).
	install -Dm644 "$srcdir/meizu-sensorspd.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-sensorspd.service
	install -Dm644 "$srcdir/72-meizu20-fastrpc-sensorspd.rules" \
		"$pkgdir"/usr/lib/udev/rules.d/72-meizu20-fastrpc-sensorspd.rules
	mkdir -p "$pkgdir"/usr/share/qcom/sm8550/Meizu/m2381
	tar xzf "$srcdir/meizu-sensors-root.tgz" \
		-C "$pkgdir"/usr/share/qcom/sm8550/Meizu/m2381
	chmod -R a+rX "$pkgdir"/usr/share/qcom
	ln -s /mnt/dsp "$pkgdir"/usr/share/qcom/sm8550/Meizu/m2381/dsp
	# r16: readiness gate + proxy re-announce (boot scan races the sensors
	# PD QRTR registration; D-Bus activation does not retry after exit).
	install -Dm755 "$srcdir/meizu-sensors-ready.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-sensors-ready.sh
	install -Dm644 "$srcdir/meizu-sensors-ready.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-sensors-ready.service
	# r21: accel-ready barrier in the GRAPHICAL transaction. kwin claims
	# SensorProxy exactly once at session start and never re-claims: a
	# session starting before the accelerometer exists (~boot+90s) loses
	# the rotation quick-settings tile for the whole boot (observed
	# 2026-10-04; a proxy restart alone does not make kwin re-claim).
	# Hold plasma-mobile until the proxy reports HasAccelerometer=true.
	install -Dm755 "$srcdir/meizu-sensors-barrier.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-sensors-barrier.sh
	install -Dm644 "$srcdir/meizu-sensors-barrier.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-sensors-barrier.service
	install -Dm644 "$srcdir/meizu-sensors-ordering.conf" \
		"$pkgdir"/usr/lib/systemd/system/plasma-mobile.service.d/meizu-sensors-ordering.conf
	# r22 (2026-10-04 device day): meizu-bind-nfc-haptics.service binds the
# boot-orphan SEs a80000 (NFC) + 994000 (haptics) every boot (autoprobe
# race family; both live-traffic-verified safe). 880000 stays lethal.
# r50: bl-clamp deleted (see r50 comment above) - the r55+ kernel
	# backlight floor (panel-boe-meizu20 BL_MIN) is the only guard now.
# r22: bind the boot-orphan GENI SEs every boot - a80000 (NFC nfc@28)
# and 994000 (haptics AW8697@5a) never auto-bind (autoprobe race
# family); both live-traffic-verified safe 2026-10-04 device day.
# r23 (2026-10-04, AW8697 driver round): 70-meizu20-vibra.rules tags the
# new aw8697-haptics input device FEEDBACKD_TYPE=vibra - feedbackd's
# manager only probes devices with that udev property (the feedbackd
# package rules cover other drivers, not this name).
	install -Dm755 "$srcdir/meizu-bind-nfc-haptics.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-bind-nfc-haptics.sh
	install -Dm644 "$srcdir/meizu-bind-nfc-haptics.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-bind-nfc-haptics.service
	install -Dm644 "$srcdir/70-meizu20-vibra.rules" \
		"$pkgdir"/usr/lib/udev/rules.d/70-meizu20-vibra.rules
	# UCM2 HiFi (silime d70e686): card conf + use case + conf.d pointer.
	# The pointer is a symlink upstream; recreated here instead of shipping
	# one (abuild flattens source= symlinks).
	# r25 (audio daily round 2026-10-04): HiFi.conf + BootSequence moved to
	# raw control units (T4c operating point) - the old dB-domain values
	# decoded to raw ~0-7 on the current 0..457 controls (boot-time mute),
	# and pulseaudio only starts using this UCM once it sees the card with
	# the files present (first happened on a reboot, not in-session).
	install -Dm644 "$srcdir/MEIZU20.conf" \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8550/MEIZU20.conf
	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8550/HiFi.conf
	# r25: meizu-audio-route pins the playback routing every boot (S1);
	# pulseaudio owns the PCM, this owns the mixer state.
	install -Dm755 "$srcdir/meizu-audio-route.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-audio-route.sh
	# r48: sound card attach floor as a real script (verify-retry loop);
	# the unit file just points at it now.
	install -Dm755 "$srcdir/meizu-sndcard-bind.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-sndcard-bind.sh
	# r48: earpiece stays earpiece - media L+R remapped onto the main
	# speaker (pulseaudio >= 16 reads /etc/pulse/default.pa.d/).
	install -Dm644 "$srcdir/meizu20-spk-mono.pa" \
		"$pkgdir"/etc/pulse/default.pa.d/meizu20-spk-mono.pa
	# r49: keep the default on meizu-spk past the plasma startup tail
	# (XDG autostart + re-assert loop).
	install -Dm755 "$srcdir/meizu-spk-default.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-spk-default.sh
	install -Dm644 "$srcdir/meizu20-spk-default.desktop" \
		"$pkgdir"/etc/xdg/autostart/meizu20-spk-default.desktop
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8550
	ln -s ../../Qualcomm/sm8550/MEIZU20.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8550/MEIZU20.conf
	# r25: alsa-lib resolves the UCM card by the card LONG name
	# ("Meizu-MEIZU20-m2381-meizu20", snd_ctl_card_info), not the short
	# topology name - without this pointer the import fails -2 and
	# pulseaudio silently falls back to the generic stereo-fallback
	# profile (found on the 2026-10-04 audio daily round).
	ln -s ../../Qualcomm/sm8550/MEIZU20.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8550/Meizu-MEIZU20-m2381-meizu20.conf
	# r8: AudioReach topology (q6apm component probe requests it; missing
	# file = component fails = no card). Path is a kernel-side contract.
	install -Dm644 "$srcdir/MEIZU20-tplg.bin" \
		"$pkgdir"/usr/lib/firmware/qcom/sm8550/MEIZU20-tplg.bin
	# r51: boot-noise cleanup quartet (all four verified live 2026-10-07):
	# 1) ddcutil EACCES storm at session start (powerdevil libddcutil scan):
	#    ignore every i2c bus at detection level + let the scan open the
	#    nodes via uaccess (EACCES 34 -> 0 per init, backlight unaffected).
	install -Dm644 "$srcdir/ddcutilrc" \
		"$pkgdir"/etc/xdg/ddcutil/ddcutilrc
	install -Dm644 "$srcdir/61-meizu20-i2c-uaccess.rules" \
		"$pkgdir"/etc/udev/rules.d/61-meizu20-i2c-uaccess.rules
	# r87 (2026-11-27): dma_heap nodes are 0600 root:root (systemd 262 ships
	# no rule for SUBSYSTEM=="dma_heap") -> session-user libcamera/plasma-camera
	# die in DmaBufAllocator, SoftwareIsp disabled, camera app exits at start.
	# Open the nodes to the video group, mirroring the video4linux convention.
	install -Dm644 "$srcdir/73-meizu20-dma-heap.rules" \
		"$pkgdir"/usr/lib/udev/rules.d/73-meizu20-dma-heap.rules
	# 2) pulse module-x11-xsmp error + failing app-pulseaudio@autostart
	#    unit (X11 session-manager modules can never connect on this
	#    Wayland-only port): replace the autostart Exec with a plain
	#    `pulseaudio --start`.
	install -Dm644 "$srcdir/meizu20-pulseaudio-no-x11.conf" \
		"$pkgdir"/usr/lib/systemd/user/app-pulseaudio@autostart.service.d/meizu20-no-x11.conf
	# 3) nm-initrd-generator.sh exits 1 every boot (networkmanager-systemd
	#    generator on a non-initrd system): /etc shadows /usr/lib per
	#    systemd.generator(7).
	install -Dm755 "$srcdir/nm-initrd-generator.sh" \
		"$pkgdir"/etc/systemd/system-generators/nm-initrd-generator.sh
	# 4) kde-fingerprint/kde-smartcard reference fingerprint-auth,
	#    smartcard-auth and postlogin PAM stacks that no package ships
	#    here: comment-only stubs = empty substack, no more
	#    _pam_load_conf_file errors. Replace with real stacks if
	#    fingerprint/smartcard support ever lands.
	install -Dm644 "$srcdir/fingerprint-auth" \
		"$pkgdir"/etc/pam.d/fingerprint-auth
	install -Dm644 "$srcdir/smartcard-auth" \
		"$pkgdir"/etc/pam.d/smartcard-auth
	install -Dm644 "$srcdir/postlogin" \
		"$pkgdir"/etc/pam.d/postlogin
	# r61: waydroid container network fix, baked (see depends comment).
	# inet filter waydroid0 pass rules + self-owned waydroid_mss MSS-clamp
	# table (upstream path MTU < 1500, ICMP frag-needed lost in NAT).
	# Purely additive snippet - never `nft -f` the main file on a live
	# system (flush ruleset kills the lxc tables; restart nftables ditto).
	install -Dm644 "$srcdir/52_waydroid.nft" \
		"$pkgdir"/etc/nftables.d/52_waydroid.nft
	# r64: cellular automation (see r64 note above); r75: mm-dial replaces
	# the retired d1_dataup/bindmux DPM chain.
	install -Dm755 "$srcdir/cell-keeper.sh" \
		"$pkgdir"/usr/lib/meizu20/cell-keeper.sh
	install -Dm755 "$srcdir/mm-dial.sh" \
		"$pkgdir"/usr/lib/meizu20/mm-dial.sh
	# r81: boot-time MM failed-state rescue (ex-mm-dial [1/6]+[2/6]; see r81 note)
	install -Dm755 "$srcdir/cell-mm-rescue.sh" \
		"$pkgdir"/usr/lib/meizu20/cell-mm-rescue.sh
	install -Dm644 "$srcdir/cell-mm-rescue.service" \
		"$pkgdir"/usr/lib/systemd/system/cell-mm-rescue.service
	# r82: resolved FallbackDNS compromise for the carrier-DNS push gap (r81 note)
	install -Dm644 "$srcdir/meizu20-resolved-fallback.conf" \
		"$pkgdir"/usr/lib/systemd/resolved.conf.d/meizu20-fallback-dns.conf
	install -Dm755 "$srcdir/cell-switch.sh" \
		"$pkgdir"/usr/bin/cell-switch.sh
	for u in cell-keeper mm-dial; do
		install -Dm644 "$srcdir/$u.service" \
			"$pkgdir"/usr/lib/systemd/system/$u.service
	done
	# r90: flashlight quicksetting mirror (see r90 note above)
	install -Dm755 "$srcdir/meizu-torch-mirror.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-torch-mirror.sh
	install -Dm644 "$srcdir/meizu-torch-mirror.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-torch-mirror.service
	# inert until the rmtfs apk leg lands (drop-in for an absent unit = no-op)
	install -Dm644 "$srcdir/10-unlimited-retry.conf" \
		"$pkgdir"/usr/lib/systemd/system/rmtfs.service.d/10-unlimited-retry.conf
	install -Dm644 "$srcdir/00-nura-qrtr-unmanaged.conf" \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/00-nura-qrtr-unmanaged.conf
	# r78: gsm profiles for the plasma-nm cellular UI (quicksettings toggle +
	# kcm_cellular_network). NM refuses keyfiles wider than 0600; autoconnect
	# is false in both files (see the r78 note above for why).
	for nmprof in meizu-mobile-data-cbnet meizu-mobile-data-cmnet; do
		install -Dm600 "$srcdir/$nmprof.nmconnection" \
			"$pkgdir"/etc/NetworkManager/system-connections/$nmprof.nmconnection
	done
	# r69: tmpfiles 三件（TFTP 根持久化 / meizu-pas 退役清扫 / temp.json 可写
	# 路径，详见 r69 注记）；r83: tempjson conf 根治版（路径挪 -R 根 + fastrpc
	# 属主，配 hexagonrpcd r9 0006 写支持，详见 conf 头注）。
	for t in meizu20-tftp-root meizu20-retire-pas meizu20-retire-dataup meizu20-retire-mmdial meizu20-retire-wfi meizu20-sensors-tempjson; do
		install -Dm644 "$srcdir/$t.conf" \
			"$pkgdir"/usr/lib/tmpfiles.d/$t.conf
	done
	# r75: dma-buf heaps boot load (libcamera SoftwareIsp allocator; r75 note ⑤).
	install -Dm644 "$srcdir/meizu20-dma-heap.conf" \
		"$pkgdir"/usr/lib/modules-load.d/meizu20-dma-heap.conf
	# r66: 掩蔽上游 hexagonrpcd-adsp-sensorspd（与本机 udev 触发的 meizu-sensorspd
	# 抢 ADSP 默认监听器位 → 本机必败重启环 = "ssc sensor session 很难起来"本体；
	# 正主 = meizu-sensorspd[10-03 完整配方 -s -R]，udev 72 号规则触发）
	mkdir -p "$pkgdir"/etc/systemd/system
	ln -sf /dev/null "$pkgdir"/etc/systemd/system/hexagonrpcd-adsp-sensorspd.service
}

