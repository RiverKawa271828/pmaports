# Reference: <https://postmarketos.org/devicepkg>
#
# Meizu 20 (m2381, SM8550 / kalama). Boot chain (2026-09-27 现态):
#   XBL -> ABL -> Mu-Silicium chainload (payload in boot_b) -> bare-jump
#   mainline arm64 Image. Mu's delivery contract: boot_b Android boot
#   image with ramdisk field = raw Image, dtb field = our DTB, MZSF stamp
#   at header 0x800; no initrd / no cmdline passed.
#
# root = userdata partition (sda22, ext4) flashed with the pmOS rootfs
# image - pmOS standard posture for Android boot chain devices. The
# kernel finds root via CONFIG_CMDLINE_FORCE (baked in
# linux-meizu-meizu20's config: root=/dev/sda22) because nothing in this
# chain can hand the kernel a cmdline or initramfs.
#
# boot_b assembly is external for now (meizu20-m1/tools/ packers +
# handoff-stamp.py); deviceinfo_generate_bootimg is intentionally NOT
# set - pmOS's mkbootimg layout (initramfs in ramdisk field) does not
# match Mu's contract. Flashing is manual fastboot from the fastboot
# sandbox (hence flash_method="none").
#
# Current interactive channel: USB NCM gadget (18d1:4ee1, 172.16.42.1)
# from the running rootfs; mkinitfs NCM+ssh takeover is blocked on Mu
# gaining initrd delivery - do not remove this comment before that.
maintainer="ri <ri@example.com>"
pkgname=device-meizu-meizu20
pkgdesc="Meizu 20 (meizu_20_CN, SM8550 / kalama)"
pkgver=1
pkgrel=22
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# usb-moded: re-binds the configfs USB gadget on cable replug/udev events.
# The initramfs only sets the gadget up once per boot; without usb-moded a
# physical replug left usb0 dead until a cold boot (observed 2026-09-27).
# The "developer" default profile keeps USB networking enabled out of the box
# (the charging profile requires enabling it manually, which is useless on a
# headless bring-up device).
# qbootctl (r3): marks the boot successful in the boot_x GPT attribute bits so
# the ABL trial counter stops burning down to fastboot. The ABL retry state
# lives in GPT entry attrs (successful/tries/active), NOT in misc - misc
# zeroing never fixed it. Binary comes from Alpine community/qbootctl
# (0.2.2); the unit + preset are ours. Slot detection without
# androidboot.slot_suffix falls back to the GPT active bit, which
# `fastboot set_active b` already set - no kernel cmdline change needed.
# r4: all runtime bring-up units packaged from the canonical overlay
# (meizu20-m1/bsp-overlay/ = single source of truth; keep both trees
# byte-identical). Touch persistence = meizu-touch.service (selective
# geni-i2c bind; 880000.i2c lethal, blacklist must stay).
# r6: meizu-touch.service synced from the overlay - gains the r22
# serialization fix (After=meizu-pas.service; both services toggle the
# global drivers_autoprobe, racing = all SEs bound = 880000.i2c external
# abort = boot panic, hit 3x on 2026-09-29). Audio: UCM2 HiFi profile
# from silime d70e686 (card conf + HiFi use case; conf.d pointer is a
# symlink recreated in package()). Card name "MEIZU20Inf" matches the
# DTS sound model byte-for-byte - do NOT rename either side.
# r7: UCM v2 - speaker/earpiece are Cirrus CS35L45 x2 (stock dtbo +
# runtime FDT + vendor wmfw evidence; the WSA883x carry conclusion was
# wrong, tfa9875 fictional). Flyme volume point translated to the
# mainline cs35l45 control domain, conservative start (no DSP firmware
# in mainline = no speaker protection). + meizu-bind-988000.sh packaged.
# r8: audio front round. i2c10/888000 amp bind persisted as
# meizu-amps.service (After=meizu-touch.service - the drivers_autoprobe
# race family must stay serialized: pas -> touch -> amps -> retimer);
# 988000 retimer bind unitized as meizu-retimer.service. AudioReach
# topology MEIZU20Inf-tplg.bin installed to /usr/lib/firmware/qcom/sm8550/
# (kernel requests exactly this path: sc8280xp.c driver_name "sm8550" x
# DTS model "MEIZU20Inf"); without it q6apm's component probe fails and
# the card cannot register. Built from meizu20-m1/audio-topology/
# meizu20.m4 (audioreach-topology pin b4c1510) - keep source and bin in sync.
# r10: qbootctl.service renamed qbootctl-meizu.service - upstream Alpine
# qbootctl now ships a qbootctl-systemd subpackage owning the old path
# (r9 rootfs install died on the overwrite conflict, 2026-10-01).
# r9: 71-meizu20-fastrpc-rootpd.rules - udev SYSTEMD_WANTS for the ADSP
# root-PD daemon, fired when /dev/fastrpc-adsp appears. DEPLOY WITH CARE:
# meizu-audio.service is preset-enabled, so installing r9 makes the next
# boot run the full WCD chain bring-up - deploy together with (or after)
# the CLASH-fix kernel, or the boot storms again (2026-10-01 note).
# r12: meizu-audio.service loses its [Install] section - a preset enable + [Install] + reused rootfs chroot historically baked an enabled symlink into images (storm on first boot); silence is now structural.
# r11 (2026-10-02, complete-image round): the image now boots fully
# stocked. depends += firmware-meizu-meizu20 (GPU/DSP/modem + ath12k WiFi
# + qca BT blobs - the 10-02 repair round hand-laid all three after the
# fresh image shipped without them) and e2fsprogs-extra (grow unit).
# meizu-grow-rootfs.service: online-resize the root ext4 to fill the
# 464G userdata partition (pmbootstrap images are ~4G; the first-boot
# 95%-full root was the 10-02 finding). preset: meizu-audio flips
# enable -> disable - default boot is now silent (the fuse dance was
# per-rootfs manual work; audio device days start the unit by hand).
# r13 (2026-10-02, A2a audio round): (a) sleep/suspend/hibernate target
# masking becomes structural via tmpfiles.d - the (十八) finding: a
# fresh image ships them unmasked; plain L, so a hand unmask survives
# reboots. (b) meizu-dsp-mount.service: active-slot dsp partition
# mounted read-only at /mnt/dsp - the file service root for the audiopd
# session daemon (unit ships with temp/hexagonrpcd, started manually
# per the B2 protocol).
depends="
	linux-meizu-meizu20
	postmarketos-base
	postmarketos-usb-moded
	postmarketos-usb-moded-default-profile-developer
	qbootctl
	busybox
	systemd
	firmware-meizu-meizu20
	e2fsprogs-extra
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modprobe.conf
	qbootctl-meizu.service
	71-meizu20-fastrpc-rootpd.rules
	80-device-meizu-meizu20.preset
	meizu-touch-load.sh
	meizu-amps-load.sh
	meizu-audio-load.sh
	meizu-bind-988000.sh
	meizu-touch.service
	meizu-amps.service
	meizu-audio.service
	meizu-retimer.service
	meizu-pas.service
	meizu-noswr.service
	meizu-quiet.service
	meizu-memsleep.service
	meizu-wfi.service
	meizu-grow-rootfs.service
	meizu-dsp-mount.service
	meizu-dsp-mount.sh
	meizu-sleepmask.conf
	devshell.service
	MEIZU20Inf.conf
	HiFi.conf
	MEIZU20Inf-tplg.bin
	meizu-sensors-root.tgz
	meizu-sensorspd.service
	72-meizu20-fastrpc-sensorspd.rules
	meizu-sensors-ready.sh
	meizu-sensors-ready.service
	meizu-sensors-barrier.sh
	meizu-sensors-barrier.service
	meizu-sensors-ordering.conf
	meizu-bl-clamp.sh
	meizu-bl-clamp.service
	meizu-bl-clamp.timer
	meizu-bind-nfc-haptics.sh
	meizu-bind-nfc-haptics.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir/modprobe.conf" \
		"$pkgdir"/etc/modprobe.d/50-meizu20-blacklist.conf
	install -Dm755 "$srcdir/meizu-touch-load.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-touch-load.sh
	# r8: i2c10/888000 amp bind (CS35L45 x2), meizu-amps.service.
	install -Dm755 "$srcdir/meizu-amps-load.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-amps-load.sh
	# r9: ordered WCD9385 SWR chain bring-up (autoload never probes),
	# meizu-audio.service.
	install -Dm755 "$srcdir/meizu-audio-load.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-audio-load.sh
	# r7: 988000 (i2c_hub_2) safe-bind helper (whitelist candidate, U3
	# round 2026-09-30); unitized by r8 meizu-retimer.service.
	# 880000 stays lethal.
	install -Dm755 "$srcdir/meizu-bind-988000.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-bind-988000.sh
	for u in qbootctl-meizu meizu-touch meizu-amps meizu-audio meizu-retimer \
		meizu-pas meizu-noswr meizu-quiet meizu-memsleep meizu-wfi meizu-grow-rootfs \
		meizu-dsp-mount devshell; do
		install -Dm644 "$srcdir/$u.service" \
			"$pkgdir"/usr/lib/systemd/system/$u.service
	done
	# r13: active-slot dsp partition mounted ro at /mnt/dsp (audiopd file
	# service root); sleep-target masking as a tmpfiles rule (structural
	# across reinstalls, hand unmask wins).
	install -Dm755 "$srcdir/meizu-dsp-mount.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-dsp-mount.sh
	install -Dm644 "$srcdir/meizu-sleepmask.conf" \
		"$pkgdir"/usr/lib/tmpfiles.d/meizu-sleepmask.conf
	install -Dm644 "$srcdir/80-device-meizu-meizu20.preset" \
		"$pkgdir"/usr/lib/systemd/system-preset/80-device-meizu-meizu20.preset
	# r9: udev trigger for the ADSP root-PD daemon session (the unit itself
	# ships later with the patched hexagonrpc; the want is inert until
	# then). A boot-time ConditionPathExists always evaluates before
	# /dev/fastrpc-adsp exists and skips forever - r38 device day note.
	install -Dm644 "$srcdir/71-meizu20-fastrpc-rootpd.rules" \
		"$pkgdir"/usr/lib/udev/rules.d/71-meizu20-fastrpc-rootpd.rules
	# r15: SSC sensors session (sensors round 2026-10-03). Kalama has no
	# SLPI remoteproc: sensor PD = adsps.jsn sensor_pd on the ADSP, served
	# via hexagonrpcd -s (INIT_ATTACH_SNS) from /dev/fastrpc-adsp, stock
	# form = /vendor/bin/sscrpcd sensorspd. The -R root carries the stock
	# sensor registry/calibration (persist harvest), kailua SEE config
	# JSONs (json.lst set) and socinfo placeholders; the dsp alias points
	# at /mnt/dsp (meizu-dsp-mount) for the DSP-side sns skel libraries
	# (libsns_dynamic_loader_skel.so et al) - without them the framework
	# never registers the sns_client QRTR service (0x190) and libssc finds
	# no sensors. udev trigger, not boot condition (rootpd r38 lesson).
	install -Dm644 "$srcdir/meizu-sensorspd.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-sensorspd.service
	install -Dm644 "$srcdir/72-meizu20-fastrpc-sensorspd.rules" \
		"$pkgdir"/usr/lib/udev/rules.d/72-meizu20-fastrpc-sensorspd.rules
	mkdir -p "$pkgdir"/usr/share/qcom/sm8550/Meizu/m2381
	tar xzf "$srcdir/meizu-sensors-root.tgz" \
		-C "$pkgdir"/usr/share/qcom/sm8550/Meizu/m2381
	chmod -R a+rX "$pkgdir"/usr/share/qcom
	ln -s /mnt/dsp "$pkgdir"/usr/share/qcom/sm8550/Meizu/m2381/dsp
	# r16: readiness gate + proxy re-announce (boot scan races the sensors
	# PD QRTR registration; D-Bus activation does not retry after exit).
	install -Dm755 "$srcdir/meizu-sensors-ready.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-sensors-ready.sh
	install -Dm644 "$srcdir/meizu-sensors-ready.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-sensors-ready.service
	# r21: accel-ready barrier in the GRAPHICAL transaction. kwin claims
	# SensorProxy exactly once at session start and never re-claims: a
	# session starting before the accelerometer exists (~boot+90s) loses
	# the rotation quick-settings tile for the whole boot (observed
	# 2026-10-04; a proxy restart alone does not make kwin re-claim).
	# Hold plasma-mobile until the proxy reports HasAccelerometer=true.
	install -Dm755 "$srcdir/meizu-sensors-barrier.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-sensors-barrier.sh
	install -Dm644 "$srcdir/meizu-sensors-barrier.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-sensors-barrier.service
	install -Dm644 "$srcdir/meizu-sensors-ordering.conf" \
		"$pkgdir"/usr/lib/systemd/system/plasma-mobile.service.d/meizu-sensors-ordering.conf
	# r22 (2026-10-04 device day): meizu-bind-nfc-haptics.service binds the
# boot-orphan SEs a80000 (NFC) + 994000 (haptics) every boot (autoprobe
# race family; both live-traffic-verified safe). 880000 stays lethal.
# r20: min-brightness clamp guard. Belt-and-braces on top of the r50
	# kernel backlight floor (panel-boe-meizu20 BL_MIN_BRIGHTNESS): bounce
	# any sub-floor brightness write back within 2s so the plasma slider
	# can never park the AMOLED black (observed 2026-10-03 device day).
	install -Dm755 "$srcdir/meizu-bl-clamp.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-bl-clamp.sh
	install -Dm644 "$srcdir/meizu-bl-clamp.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-bl-clamp.service
	install -Dm644 "$srcdir/meizu-bl-clamp.timer" \
		"$pkgdir"/usr/lib/systemd/system/meizu-bl-clamp.timer
	# r22: bind the boot-orphan GENI SEs every boot - a80000 (NFC nfc@28)
	# and 994000 (haptics AW8697@5a) never auto-bind (autoprobe race
	# family); both live-traffic-verified safe 2026-10-04 device day.
	install -Dm755 "$srcdir/meizu-bind-nfc-haptics.sh" \
		"$pkgdir"/usr/lib/meizu20/meizu-bind-nfc-haptics.sh
	install -Dm644 "$srcdir/meizu-bind-nfc-haptics.service" \
		"$pkgdir"/usr/lib/systemd/system/meizu-bind-nfc-haptics.service
	# UCM2 HiFi (silime d70e686): card conf + use case + conf.d pointer.
	# The pointer is a symlink upstream; recreated here instead of shipping
	# one (abuild flattens source= symlinks).
	install -Dm644 "$srcdir/MEIZU20Inf.conf" \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8550/MEIZU20Inf.conf
	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8550/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8550
	ln -s ../../Qualcomm/sm8550/MEIZU20Inf.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8550/MEIZU20Inf.conf
	# r8: AudioReach topology (q6apm component probe requests it; missing
	# file = component fails = no card). Path is a kernel-side contract.
	install -Dm644 "$srcdir/MEIZU20Inf-tplg.bin" \
		"$pkgdir"/usr/lib/firmware/qcom/sm8550/MEIZU20Inf-tplg.bin
}

