# r80 (P3 蜂窝标准化): autoconnect 翻正回上游默认 true——单 active 槽姿态在位
# （keeper 压制 upstream MM 双槽 bug），NM 承担 boot 数据面（mm-dial 同轮退役）。
# r78: 广电卡（460-15）数据 profile —— APN cbnet（一百二十终验真值）。
# r83: dns-search=cellular 同 cmnet 件（carrier DNS 上 resolved link 的门钥匙，
# 理由见该文件头 r83 注记）。
[connection]
id=meizu-mobile-data
uuid=30e37ba8-54b4-4df5-953d-9570be1d05c8
type=gsm
autoconnect=true

[gsm]
apn=cbnet

[ipv4]
dns-search=cellular
method=auto

[ipv6]
addr-gen-mode=default
method=disabled

[proxy]
