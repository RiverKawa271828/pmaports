[Unit]
Description=Meizu 20 audio: pin playback routing to the T4c operating point
# Audio daily round S1 (2026-10-04): pulseaudio claims the card via
# module-udev-detect, but nothing routes FE MultiMedia1 to the CS35L45 BE
# or enables the amps - without this floor the desktop is silent after
# every boot. Ordering is strictly after the sndcard bind floor; the
# card can still take ~90s to register (ADSP boot + deferred probe), so
# the script polls and the unit gets a generous start timeout.
After=meizu-sndcard-bind.service

[Service]
Type=oneshot
ExecStart=/usr/lib/meizu20/meizu-audio-route.sh
RemainAfterExit=yes
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
