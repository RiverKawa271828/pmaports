	networkmanager
	bluez
	polkit-elogind
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-pd-mapper
	soc-qcom-qbootctl
	systemd-boot
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
"
	source="
	00-phoenix-notification-policy
	00-phoenix-notification-policy.lock
	52_phoenix_eth_trust.nft
	90-phoenix-mac.conf
	90-phoenix-wlan-mac.preset
	90-phoenix-typec-sink.preset
	90-phoenix-timesync.preset
