build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/hexagonrpcd.confd \
		"$pkgdir"/usr/share/hexagonrpcd/hexagonrpcd-sdsp.conf

	# Use hardware MAC addresses (disable NetworkManager randomized MAC mode).
	install -Dm644 "$srcdir"/90-phoenix-mac.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/90-phoenix-mac.conf

	# Trust eth* interface (USB-C hub Ethernet) so hosted services like the
	# phoenix-device-monitor dashboard are reachable on the LAN by default.
	install -Dm644 "$srcdir"/52_phoenix_eth_trust.nft \
		"$pkgdir"/etc/nftables.d/52_phoenix_eth_trust.nft

	# Keep the display off for notification/task-complete events.
	install -Dm644 "$srcdir"/00-phoenix-notification-policy \
		"$pkgdir"/etc/dconf/db/local.d/00-phoenix-notification-policy
	install -Dm644 "$srcdir"/00-phoenix-notification-policy.lock \
		"$pkgdir"/etc/dconf/db/local.d/locks/00-phoenix-notification-policy
	install -Dm644 "$srcdir"/dconf-profile-user \
		"$pkgdir"/etc/dconf/profile/user

	# greetd is started without a packaged config on phosh images; without
	# /etc/greetd/config.toml the greeter fails and hits start-limit.
	install -Dm644 "$srcdir"/49-phoenix-network.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/49-phoenix-network.rules

	# RTC is read-only on this board; let Settings manage time/NTP without
	# a polkit dialog (which renders as an apparent freeze on the phone),
	# and enable timesyncd via preset so the clock is always sane.
	install -Dm644 "$srcdir"/49-phoenix-timedate.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/49-phoenix-timedate.rules
	install -Dm644 "$srcdir"/90-phoenix-timesync.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-phoenix-timesync.preset
	install -Dm644 "$srcdir"/81-libssc-xiaomi-phoenix.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-xiaomi-phoenix.rules

	# Plasma 6 has no uaccess rule for backlight; without this the user
	# cannot adjust screen brightness at all (raw sysfs node, mode 0644).
	install -Dm644 "$srcdir"/90-phoenix-backlight.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-phoenix-backlight.rules

	install -Dm644 "$srcdir"/greetd-config.toml \
		"$pkgdir"/etc/greetd/config.toml

	# uim-selection must run after the modem is up, otherwise it exits
	# without selecting the SIM session and MM puts the modem in failed.
	install -Dm644 "$srcdir"/no-dnssec.conf \
		"$pkgdir"/etc/systemd/resolved.conf.d/no-dnssec.conf

	install -Dm644 "$srcdir"/phoenix-wait.conf \
		"$pkgdir"/usr/lib/systemd/system/msm-modem-uim-selection.service.d/phoenix-wait.conf

	# Ath10k can fall back to random MAC when calibration data doesn't provide
	# one. Apply a deterministic, persisted MAC before NetworkManager starts.
	# Enable via systemd preset only - postmarketos-base runs
	# `systemctl preset-all` at image build, and post-install/post-upgrade
	# re-applies via `systemctl reenable`. A package-shipped manual
	# WantedBy symlink would conflict with that flow and resurrect the
	# unit after a user `systemctl disable`.
	install -Dm755 "$srcdir"/phoenix-wlan-mac.sh \
		"$pkgdir"/usr/libexec/phoenix-wlan-mac.sh
	install -Dm644 "$srcdir"/phoenix-wlan-mac.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-wlan-mac.service
	install -Dm644 "$srcdir"/90-phoenix-wlan-mac.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-phoenix-wlan-mac.preset

	# Phoenix's ADSP firmware's sensor_process PD fails SNS_REG_INIT every
	# ~4s, and the default qcom_q6v5_pas recovery=enabled policy restarts the
	# whole ADSP on each crash -- ~11 crashes/min, ~20°C of extra package
	# heat, and battery drain rate that exhausts a full charge in ~1h.
	# Disable the recovery loop early in boot; audio is broken anyway.
	install -Dm644 "$srcdir"/adsp-disable-recovery.service \
		"$pkgdir"/usr/lib/systemd/system/adsp-disable-recovery.service

	# s2idle is only wakeable (pwrkey) and non-self-aborting when the CPUs
	# never enter rail-power-collapse; see the unit file for the full
	# root-cause chain. Enabled via the systemd preset below.
	install -Dm644 "$srcdir"/phoenix-suspend-wfi.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-suspend-wfi.service

	# usb-signaller emits "USB connected" for any typec attach, including
	# DCP/PD wall chargers with no data lines, which pops the USB mode
	# selector on every charge. Ship a patched notify daemon (selector only
	# for SDP/CDP data hosts) and point the user service at it via drop-in.
	# PD is deliberately excluded from the dialog: PD partners here are
	# almost always power bricks.
	install -Dm755 "$srcdir"/phoenix-usb-moded-notify \
		"$pkgdir"/usr/libexec/phoenix-usb-moded-notify
	# abuild flattens subdirectory sources into srcdir/, hence basename.
	install -Dm644 "$srcdir"/phoenix.conf \
		"$pkgdir"/usr/lib/systemd/user/usb-moded-notify.service.d/phoenix.conf

	# Auto-recover "stuck as source" after PC -> wall charger transitions:
	# a data-less partner while we source and discharge gets flipped back
	# to sink. Deliberate hubs enumerate usb_device and are left alone.
	# Enabled by default via preset; see script header for full rationale.
	install -Dm755 "$srcdir"/phoenix-typec-sink.sh \
		"$pkgdir"/usr/libexec/phoenix-typec-sink.sh
	install -Dm644 "$srcdir"/phoenix-typec-sink.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-typec-sink.service
	install -Dm644 "$srcdir"/phoenix-typec-sink.timer \
		"$pkgdir"/usr/lib/systemd/system/phoenix-typec-sink.timer
	install -Dm644 "$srcdir"/90-phoenix-typec-sink.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-phoenix-typec-sink.preset

	# Reboot once to converge out of the probabilistic DSP degraded boot
	# state (no sound + no sensors ~20-30% of boots). Persist counter
	# prevents a reboot loop. See script header for rationale.
	install -Dm755 "$srcdir"/phoenix-dsp-recovery.sh \
		"$pkgdir"/usr/libexec/phoenix-dsp-recovery.sh
	install -Dm644 "$srcdir"/phoenix-dsp-recovery.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-dsp-recovery.service

	# Cap the SMB5 input current at 500mA while the source is an SDP port.
	# Stopgap for the kernel-side BC1.2 misclassification that leaves a
	# strict SDP port buckling under the DCP limit, draining the battery
	# while "plugged in" (2026-09-01). Enabled by default via preset.
	install -Dm755 "$srcdir"/phoenix-sdp-cap.sh \
		"$pkgdir"/usr/libexec/phoenix-sdp-cap.sh
	install -Dm644 "$srcdir"/phoenix-sdp-cap.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-sdp-cap.service
	install -Dm644 "$srcdir"/phoenix-sdp-cap.timer \
		"$pkgdir"/usr/lib/systemd/system/phoenix-sdp-cap.timer
	install -Dm644 "$srcdir"/90-phoenix-sdp-cap.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-phoenix-sdp-cap.preset

	# --- Optional server-mode add-ons (source files live in extra-addon/) ----
	# These ship installed but DISABLED. Opt in per machine with
	# `systemctl enable --now <unit>`. See extra-addon/README.md for context.

	# Charge limiter. Pauses charging at 70%, resumes at 60% (hysteresis).
	# Enable: `systemctl enable --now phoenix-charge-cap.timer`
	# Tune:   /etc/phoenix-charge-cap.conf
	install -Dm755 "$srcdir"/phoenix-charge-cap.sh \
		"$pkgdir"/usr/libexec/phoenix-charge-cap.sh
	install -Dm644 "$srcdir"/phoenix-charge-cap.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-charge-cap.service
	install -Dm644 "$srcdir"/phoenix-charge-cap.timer \
		"$pkgdir"/usr/lib/systemd/system/phoenix-charge-cap.timer
	install -Dm644 "$srcdir"/phoenix-charge-cap.conf \
		"$pkgdir"/etc/phoenix-charge-cap.conf

	# Panel blanker for headless / multi-user.target installs.
	# Enable: `systemctl enable --now phoenix-screen-off.service`
	install -Dm644 "$srcdir"/phoenix-screen-off.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-screen-off.service

	# Rescue from "stuck as source" typec state after charger removal.
	# Enable: `systemctl enable --now phoenix-typec-recover.timer`
	# Tune:   /etc/phoenix-typec-recover.conf
	install -Dm755 "$srcdir"/phoenix-typec-recover.sh \
		"$pkgdir"/usr/libexec/phoenix-typec-recover.sh
	install -Dm644 "$srcdir"/phoenix-typec-recover.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-typec-recover.service
	install -Dm644 "$srcdir"/phoenix-typec-recover.timer \
		"$pkgdir"/usr/lib/systemd/system/phoenix-typec-recover.timer
	install -Dm644 "$srcdir"/phoenix-typec-recover.conf \
		"$pkgdir"/etc/phoenix-typec-recover.conf

	# Cold-boot USB host wake: forces a usb_role_switch device→host
	# toggle if eth0 doesn't appear within 45s of multi-user.target.
	# Self-heals the case where a Type-C hub is attached at power-on,
	# so qcom-pmic-typec never fires an attach event and xhci-hcd never
	# probes. Required for unattended recovery after a power outage.
	# Enable: `systemctl enable phoenix-usb-host-wake.service`
	install -Dm755 "$srcdir"/phoenix-usb-host-wake.sh \
		"$pkgdir"/usr/libexec/phoenix-usb-host-wake.sh
	install -Dm644 "$srcdir"/phoenix-usb-host-wake.service \
		"$pkgdir"/usr/lib/systemd/system/phoenix-usb-host-wake.service

	# ------------------------------------------------------------------------

	# Passwordless root access for default postmarketOS user over doas/sudo.
	# This mirrors the live fix and makes it persistent across fresh flashes.
	install -Dm600 "$srcdir"/doas-user-nopass.conf \
		"$pkgdir"/etc/doas.d/99-user-nopass.conf
	install -Dm440 "$srcdir"/sudoers-user-nopass.conf \
		"$pkgdir"/etc/sudoers.d/90-user-nopass

	# Enable NetworkManager at boot (required for WiFi/Ethernet in phosh)
	mkdir -p "$pkgdir"/etc/runlevels/default
	ln -sf /etc/init.d/networkmanager \
		"$pkgdir"/etc/runlevels/default/networkmanager

	# Enable Bluetooth at boot
	ln -sf /etc/init.d/bluetooth \
		"$pkgdir"/etc/runlevels/default/bluetooth

	# Enable elogind at boot (required for phosh reboot/shutdown)
	ln -sf /etc/init.d/elogind \
		"$pkgdir"/etc/runlevels/default/elogind
}

subpackages="$pkgname-nonfree-firmware:nonfree_firmware"

nonfree_firmware() {
	pkgdesc="Firmware for GPU, WiFi, modem, DSP (required for most functionality)"
	depends="firmware-xiaomi-phoenix"
	mkdir "$subpkgdir"
}

