From: phoenix port <fix@me>
Subject: [PATCH] arm64: dts: qcom: pm6150: add bat_id ADC channel to QGauge

Matches sm7150-mainline/linux next branch pm6150.dtsi:

- add bat_id@4b child under pm6150_adc (BAT_ID with 100k pull-up);
- wire the second io-channel into the QGauge node;
- drop the now-unused spmi-sdam nvram@b600 node (driver reads SRAM
  through the PMIC regmap after patch "qcom_qg: access SRAM via
  regmap").

Source of truth:
https://github.com/sm7150-mainline/linux/tree/next (cc84c98, 9fe762c)

Signed-off-by: phoenix port <fix@me>
---
--- a/arch/arm64/boot/dts/qcom/pm6150.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm6150.dtsi
@@ -168,6 +168,14 @@
 				qcom,hw-settle-time = <200>;
 				qcom,pre-scaling = <1 1>;
 			};
+
+			bat_id@4b {
+				reg = <ADC5_BAT_ID_100K_PU>;
+				label = "bat_id";
+				qcom,ratiometric;
+				qcom,hw-settle-time = <200>;
+				qcom,pre-scaling = <1 1>;
+			};
 		};
 
 		pm6150_adc_tm: adc-tm@3500 {
@@ -184,10 +192,10 @@
 			compatible = "qcom,pm6150-qg";
 			reg = <0x4800>;
 
-			io-channels = <&pm6150_adc ADC5_BAT_THERM_100K_PU>;
-			io-channel-names = "batt-therm";
-
-			nvmem = <&pm6150_qg_sdam>;
+			io-channels = <&pm6150_adc ADC5_BAT_THERM_100K_PU>,
+				      <&pm6150_adc ADC5_BAT_ID_100K_PU>;
+			io-channel-names = "batt-therm",
+					   "batt-id";
 
 			status = "disabled";
 		};
@@ -200,14 +208,6 @@
 			status = "disabled";
 		};
 
-		pm6150_qg_sdam: nvram@b600 {
-			compatible = "qcom,spmi-sdam";
-			reg = <0xb600>;
-			#address-cells = <1>;
-			#size-cells = <1>;
-			ranges = <0 0xb600 0x100>;
-		};
-
 		pm6150_gpios: gpio@c000 {
 			compatible = "qcom,pm6150-gpio", "qcom,spmi-gpio";
 			reg = <0xc000>;
