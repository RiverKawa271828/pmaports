From 639fb3ea48d26611c04cefd0f55791e4e6b8ba90 Mon Sep 17 00:00:00 2001
From: phoenix port <fix@me>
Date: Fri, 18 Sep 2026 09:16:52 +0800
Subject: [PATCH 04/13] ASoC: tfa987x: add speaker gain control

---
 sound/soc/codecs/tfa9872.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/sound/soc/codecs/tfa9872.c b/sound/soc/codecs/tfa9872.c
index 26bed4305..f7f8675bb 100644
--- a/sound/soc/codecs/tfa9872.c
+++ b/sound/soc/codecs/tfa9872.c
@@ -10,6 +10,7 @@
 #include <linux/module.h>
 #include <linux/regmap.h>
 #include <sound/soc.h>
+#include <sound/tlv.h>
 
 #define TFA987X_SYS_CTRL0		0x00
 #define TFA987X_SYS_CTRL0_PWDN_MSK	BIT(0)
@@ -109,11 +110,25 @@ static const struct snd_soc_dapm_route tfa987x_dapm_routes[] = {
 	{"Speaker", NULL, "PWUP"},
 };
 
+/*
+ * TDMSPKG, the TDM to amplifier gain: 6 dB base + 1 dB per step.
+ * The register is freely writeable after the soft reset done in probe,
+ * no hide key dance needed.
+ */
+static const DECLARE_TLV_DB_SCALE(tfa987x_spkg_tlv, 600, 100, 0);
+
+static const struct snd_kcontrol_new tfa987x_controls[] = {
+	SOC_SINGLE_TLV("Speaker Driver Playback Volume", TFA987X_TDM_CFG8,
+		       6, 15, 0, tfa987x_spkg_tlv),
+};
+
 static const struct snd_soc_component_driver tfa987x_component = {
 	.dapm_widgets		= tfa987x_dapm_widgets,
 	.num_dapm_widgets	= ARRAY_SIZE(tfa987x_dapm_widgets),
 	.dapm_routes		= tfa987x_dapm_routes,
 	.num_dapm_routes	= ARRAY_SIZE(tfa987x_dapm_routes),
+	.controls		= tfa987x_controls,
+	.num_controls		= ARRAY_SIZE(tfa987x_controls),
 	.idle_bias_on		= 1,
 	.use_pmdown_time	= 1,
 	.endianness		= 1,
-- 
