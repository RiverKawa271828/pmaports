 #define USBIN_CURRENT_LIMIT_CFG				0x370
 
+/* DCDC page registers, reached through the charger peripheral base */
+#define DCDC_FSW_SEL					0x150
+#define DCDC_FSW_MASK					GENMASK(3, 0)
+
+#define SMBX_FSW_2400KHZ				0x7
+#define SMBX_FSW_2100KHZ				0x8
+#define SMBX_FSW_1600KHZ				0xb
+#define SMBX_FSW_1200KHZ				0xf
+
+/*
+ * Input over-voltage protection window. It must cover the negotiated
+ * USB-PD contract voltage or the charger latches PAUSE.
+ */
+#define USBIN_ADAPTER_ALLOW_CFG				0x360
+
+enum usbin_adapter_allow {
+	USBIN_ADAPTER_ALLOW_5V				= 0x0,
+	USBIN_ADAPTER_ALLOW_9V				= 0x2,
+	USBIN_ADAPTER_ALLOW_12V				= 0x4,
+	USBIN_ADAPTER_ALLOW_5V_TO_9V			= 0x8,
+	USBIN_ADAPTER_ALLOW_5V_OR_9V_TO_12V		= 0x7,
+};
+
 #define USBIN_AICL_OPTIONS_CFG				0x380
 #define SUSPEND_ON_COLLAPSE_USBIN_BIT			BIT(7)
 #define USBIN_AICL_START_AT_MAX_BIT			BIT(5)
@@ -208,6 +232,9 @@
 #define CDP_CURRENT_UA					1500000
 #define DCP_CURRENT_UA					1500000
 #define CURRENT_MAX_UA					DCP_CURRENT_UA
+
+/* Interval for the USB-PD contract / fault-latch watchdog while online */
+#define PD_POLL_INTERVAL_MS				5000
 /* clang-format on */
 
