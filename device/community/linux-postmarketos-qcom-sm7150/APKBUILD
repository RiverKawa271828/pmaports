	0013-ath10k-force-passive-scan-5ghz-wcn3990.patch
	0014-input-add-qcom-vibrator-ldo-driver.patch
	0015-tfa987x-add-speaker-volume-control.patch
	0016-arm64-dts-phoenix-add-audio-nodes.patch
	0017-power-supply-qcom-qg-report-status.patch
