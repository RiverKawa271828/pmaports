# Co-Maintainer: David Wronek <david@mainlining.org>
# Co-Maintainer: Aelin <aelin@postmarketos.org>
maintainer="Danila Tikhonov <danila@jiaxyga.com>"
_flavor="postmarketos-qcom-sm7150"
pkgname=linux-$_flavor
pkgver=7.1_rc3
pkgrel=19
pkgdesc="Mainline Kernel fork for SM7150 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm7150-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	"
makedepends="
	bison
	clang
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	zstd
"

_tag="$pkgver"

# Source
source="
	$pkgname-v$_tag.tar.gz::$url/archive/v$_tag.tar.gz
	config-$_flavor.$arch
	0001-arm64-dts-qcom-phoenix-device-support-consolidated-D.patch
	0002-drm-panel-add-G7B-37.02.0A-DSC-panel-driver-phoenix.patch
	0003-input-misc-add-Qualcomm-QPNP-vibrator-LDO-driver.patch
	0004-ASoC-tfa987x-add-speaker-gain-control.patch
	0005-ath10k-WCN3990-fixes-skip-quiet-mode-force-5GHz-pass.patch
	0006-remoteproc-qcom-q6v5-make-handover-IRQ-one-shot.patch
	0007-misc-fastrpc-fix-DMA-address-corruption-and-user-UAF.patch
	0008-media-venus-add-SM7150-support-and-firmware-idle-deb.patch
	0009-media-camss-csiphy-stock-lane-table-for-sm7150.patch
	0010-power-supply-qcom_smbx-SDP-ICL-AICL-handling-and-PD-.patch
	0011-power-supply-qcom_qg-software-gauge-and-battery-iden.patch
	0012-power-supply-qcom_smbx-program-FCC-from-DT-battery-p.patch
	0013-power-supply-qcom_smbx-follow-TCPM-contract-for-inpu.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs-tmp

	mkdir -p "$pkgdir"/boot/dtbs/qcom
	cp -r "$pkgdir"/boot/dtbs-tmp/qcom/sm7150* "$pkgdir"/boot/dtbs/qcom
	rm -rf "$pkgdir"/boot/dtbs-tmp

	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}


