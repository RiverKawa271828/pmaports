Date: Fri, 18 Sep 2026 09:17:18 +0800
Subject: [PATCH 11/13] power: supply: qcom_qg: software gauge and battery
 identity

OCV/SOC LUT interpolation + relax anchoring + coulomb counting (fixes
stuck-5% display after deep discharge), SRAM regmap access, batt-id
channel, manufacturer/serial identity, charge status fix.
---
 drivers/power/supply/qcom_qg.c | 335 +++++++++++++++++++++++++++++++--
 1 file changed, 316 insertions(+), 19 deletions(-)

diff --git a/drivers/power/supply/qcom_qg.c b/drivers/power/supply/qcom_qg.c
index 18276976c..3c749eb1d 100644
--- a/drivers/power/supply/qcom_qg.c
+++ b/drivers/power/supply/qcom_qg.c
@@ -6,11 +6,13 @@
 #include <linux/iio/consumer.h>
 #include <linux/init.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/ktime.h>
 #include <linux/module.h>
-#include <linux/nvmem-consumer.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/power_supply.h>
 #include <linux/regmap.h>
 
@@ -20,23 +22,79 @@
 #define QG_LAST_ADC_V_DATA0_REG		0xc0 /* 2-byte 0xc0-0xc1 */
 #define QG_LAST_ADC_I_DATA0_REG		0xc2 /* 2-byte 0xc2-0xc3 */
 
+/* Battery ID: BAT_ID pin has a 100 kOhm pull-up to the 1.875 V rail. */
+#define QG_BATT_ID_PULLUP_OHM		100000
+#define QG_BATT_ID_PULLUP_UV		1875000
+
 /* SRAM offsets */
+#define QG_SRAM_BASE			0xb600
 #define QG_SDAM_OCV_OFFSET		0x4c /* 4-byte 0x4c-0x4f */
 #define QG_SDAM_LEARNED_CAPACITY_OFFSET	0x68 /* 2-byte 0x68-0x69 */
 
+/* |current| below this is treated as taper/no charge current */
+#define QG_STATUS_CURRENT_MARGIN_UA	50000
+
+/* |average current| at or below this means the battery is relaxed and
+ * the terminal voltage can stand in for the open-circuit voltage */
+#define QG_RELAX_CURRENT_UA		100000
+
+/*
+ * Battery OCV/SOC lookup table supplied from the stock battery profile:
+ * a matrix of OCV (uV) indexed by SOC (rows, x100, descending) and
+ * temperature (columns, degC, ascending).  Stock firmware interpolates
+ * the measured open-circuit voltage against this table to estimate the
+ * state of charge.
+ */
+struct qcom_qg_lut {
+	s32 *temp;		/* degC, strictly ascending */
+	u32 *soc;		/* SOC x 100, descending */
+	u32 *ocv;		/* uV, num_soc rows x num_temp cols */
+	int num_temp;
+	int num_soc;
+};
+
 struct qcom_qg_chip {
 	struct device *dev;
 	struct regmap *regmap;
 	unsigned int base;
 
+	struct iio_channel *batt_id_chan;
 	struct iio_channel *batt_therm_chan;
 
-	struct nvmem_device *sdam;
-
 	struct power_supply *batt_psy;
 	struct power_supply_battery_info *batt_info;
+
+	struct qcom_qg_lut lut;
+
+	/* software SOC state (see qcom_qg_capacity_from_lut) */
+	bool			soc_init;
+	s32			soc_est;	/* percent x 100 */
+	ktime_t			soc_last_sample;
+
+	const char *manufacturer;
+	char serial[16];
 };
 
+/*
+ * The battery pack carries a pull-down (BAT_ID) resistor that identifies
+ * it; expose its resistance as a stable serial number so battery swaps are
+ * detectable from userspace.
+ */
+static void qcom_qg_read_batt_id(struct qcom_qg_chip *chip)
+{
+	int uv, ret;
+
+	ret = iio_read_channel_processed(chip->batt_id_chan, &uv);
+	if (ret < 0 || uv <= 0 || uv >= QG_BATT_ID_PULLUP_UV) {
+		strscpy(chip->serial, "unknown", sizeof(chip->serial));
+		return;
+	}
+
+	scnprintf(chip->serial, sizeof(chip->serial), "%d",
+		  (int)div64_u64((u64)QG_BATT_ID_PULLUP_OHM * uv,
+				 QG_BATT_ID_PULLUP_UV - uv));
+}
+
 static int qcom_qg_get_current(struct qcom_qg_chip *chip, u8 offset, int *val)
 {
 	s16 temp;
@@ -78,11 +136,176 @@ static int qcom_qg_get_voltage(struct qcom_qg_chip *chip, u8 offset, int *val)
 	return 0;
 }
 
+static void qcom_qg_parse_lut(struct qcom_qg_chip *chip)
+{
+	struct qcom_qg_lut *lut = &chip->lut;
+	int n_temp, n_soc, n_data, i;
+
+	n_temp = of_property_count_u32_elems(chip->dev->of_node,
+					     "qcom,ocv-temp-legend");
+	n_soc = of_property_count_u32_elems(chip->dev->of_node,
+					    "qcom,ocv-soc-legend");
+	n_data = of_property_count_u32_elems(chip->dev->of_node,
+					     "qcom,ocv-lut-data");
+	if (n_temp < 2 || n_soc < 2 || n_data != n_temp * n_soc)
+		return; /* no usable LUT: keep the linear estimation */
+
+	lut->temp = devm_kcalloc(chip->dev, n_temp, sizeof(*lut->temp),
+				 GFP_KERNEL);
+	lut->soc = devm_kcalloc(chip->dev, n_soc, sizeof(*lut->soc),
+				GFP_KERNEL);
+	lut->ocv = devm_kcalloc(chip->dev, n_data, sizeof(*lut->ocv),
+				GFP_KERNEL);
+	if (!lut->temp || !lut->soc || !lut->ocv)
+		return;
+
+	if (of_property_read_u32_array(chip->dev->of_node,
+				       "qcom,ocv-lut-data",
+				       lut->ocv, n_data) ||
+	    of_property_read_u32_array(chip->dev->of_node,
+				       "qcom,ocv-soc-legend",
+				       lut->soc, n_soc))
+		return;
+
+	for (i = 0; i < n_temp; i++) {
+		u32 t;
+
+		if (of_property_read_u32_index(chip->dev->of_node,
+					       "qcom,ocv-temp-legend",
+					       i, &t))
+			return;
+		lut->temp[i] = (s32)t;
+		if (i && lut->temp[i] <= lut->temp[i - 1])
+			return; /* legend must be strictly ascending */
+	}
+
+	lut->num_temp = n_temp;
+	lut->num_soc = n_soc;
+
+	dev_dbg(chip->dev, "battery OCV/SOC LUT: %d rows x %d cols\n",
+		n_soc, n_temp);
+}
+
+/* OCV of a SOC row, interpolated across the temperature columns */
+static int qcom_qg_lut_row_ocv(const struct qcom_qg_lut *lut,
+			       int row, int col, int degc)
+{
+	int ocv = lut->ocv[row * lut->num_temp + col];
+
+	if (col + 1 < lut->num_temp) {
+		int next = lut->ocv[row * lut->num_temp + col + 1];
+		int span = lut->temp[col + 1] - lut->temp[col];
+
+		ocv += (next - ocv) * (degc - lut->temp[col]) / span;
+	}
+
+	return ocv;
+}
+
+/* SOC (percent x 100) for an OCV/temperature pair, from the LUT */
+static int qcom_qg_lut_soc(const struct qcom_qg_lut *lut, int ocv_uv,
+			   int degc, s32 *soc)
+{
+	int col, row;
+
+	degc = clamp_t(int, degc, lut->temp[0], lut->temp[lut->num_temp - 1]);
+	for (col = 0; col < lut->num_temp - 2 && degc > lut->temp[col + 1];
+	     col++)
+		;
+
+	/* Find the SOC rows bracketing the measured OCV at this temperature */
+	for (row = 0; row < lut->num_soc - 1; row++) {
+		int ocv_hi = qcom_qg_lut_row_ocv(lut, row, col, degc);
+		int ocv_lo = qcom_qg_lut_row_ocv(lut, row + 1, col, degc);
+
+		if (ocv_uv >= ocv_lo) {
+			if (ocv_uv >= ocv_hi)
+				*soc = lut->soc[row];
+			else
+				*soc = lut->soc[row] +
+				       ((int)lut->soc[row + 1] - (int)lut->soc[row]) *
+				       (ocv_uv - ocv_hi) / (ocv_lo - ocv_hi);
+			return 0;
+		}
+	}
+
+	*soc = 0;
+	return 0;
+}
+
+static int qcom_qg_charge_full_uah(struct qcom_qg_chip *chip, int *uah)
+{
+	int ret, raw = 0;
+
+	ret = regmap_raw_read(chip->regmap, QG_SRAM_BASE +
+			      QG_SDAM_LEARNED_CAPACITY_OFFSET, &raw, 2);
+	if (!ret) {
+		*uah = (raw & 0xffff) * 1000; /* mAh to uAh */
+		if (*uah > 0)
+			return 0;
+	}
+
+	*uah = chip->batt_info->charge_full_design_uah;
+	return 0;
+}
+
 /*
- * Yes, this function simply calculates the capacity based on
- * the current voltage. This will be rewritten in the future.
+ * The OCV held in SRAM is only the last value the gauge learned, and it
+ * can be arbitrarily stale: it is re-learned solely when the battery
+ * relaxes, which never happens while plugged in and may not happen for
+ * a long time otherwise.  Trusting it pins the reported capacity to a
+ * fixed number -- e.g. a deep discharge learns a low OCV that sticks
+ * even as the battery recharges.
+ *
+ * So instead of trusting it, maintain a software estimate: while the
+ * average current is small the terminal voltage approximates the true
+ * OCV and re-anchors the estimate; in between, coulomb counting
+ * extrapolates from the last anchor.
  */
-static int qcom_qg_get_capacity(struct qcom_qg_chip *chip, int *val)
+static int qcom_qg_capacity_from_lut(struct qcom_qg_chip *chip, int *val)
+{
+	int iavg, vavg, degc, ret;
+	ktime_t now;
+
+	ret = qcom_qg_get_voltage(chip, QG_S2_NORMAL_AVG_V_DATA0_REG, &vavg);
+	if (ret)
+		return ret;
+
+	ret = qcom_qg_get_current(chip, QG_S2_NORMAL_AVG_I_DATA0_REG, &iavg);
+	if (ret)
+		return ret;
+
+	if (iio_read_channel_processed(chip->batt_therm_chan, &degc) < 0)
+		degc = 25000; /* no temperature reading: assume 25 degC */
+	degc /= 1000;
+
+	now = ktime_get_boottime();
+
+	if (!chip->soc_init || abs(iavg) <= QG_RELAX_CURRENT_UA) {
+		ret = qcom_qg_lut_soc(&chip->lut, vavg, degc, &chip->soc_est);
+		if (ret)
+			return ret;
+	} else {
+		int cf_uah;
+		s64 ua_ms;
+
+		qcom_qg_charge_full_uah(chip, &cf_uah);
+		ua_ms = (s64)iavg * ktime_ms_delta(now, chip->soc_last_sample);
+		/*
+		 * percent x 100 = uA * ms / 3600000 / uAh * 10000
+		 *               = uA * ms / (360 * uAh)
+		 */
+		chip->soc_est += div64_s64(ua_ms, (s64)cf_uah * 360);
+	}
+
+	chip->soc_last_sample = now;
+	chip->soc_init = true;
+
+	*val = clamp_t(s32, DIV_ROUND_CLOSEST(chip->soc_est, 100), 0, 100);
+	return 0;
+}
+
+static int qcom_qg_capacity_from_voltage(struct qcom_qg_chip *chip, int *val)
 {
 	int ret, voltage_now;
 	int voltage_min = chip->batt_info->voltage_min_design_uv;
@@ -106,6 +329,63 @@ static int qcom_qg_get_capacity(struct qcom_qg_chip *chip, int *val)
 	return 0;
 }
 
+/*
+ * With a battery profile LUT the capacity comes from a software gauge
+ * anchored on the terminal voltage (see qcom_qg_capacity_from_lut).
+ * Otherwise this falls back to simply calculating the capacity from the
+ * current voltage.
+ */
+static int qcom_qg_get_capacity(struct qcom_qg_chip *chip, int *val)
+{
+	if (chip->lut.ocv)
+		return qcom_qg_capacity_from_lut(chip, val);
+
+	return qcom_qg_capacity_from_voltage(chip, val);
+}
+
+static int qcom_qg_get_status(struct qcom_qg_chip *chip, int *val)
+{
+	union power_supply_propval prop = { 0 };
+	int ret, ucur, uvolt;
+
+	if (!power_supply_am_i_supplied(chip->batt_psy)) {
+		*val = POWER_SUPPLY_STATUS_DISCHARGING;
+		return 0;
+	}
+
+	/*
+	 * Prefer what our charger reports; it knows about termination,
+	 * input suspension and charge inhibition better than any
+	 * current-sign heuristic.
+	 */
+	ret = power_supply_get_property_from_supplier(chip->batt_psy,
+					POWER_SUPPLY_PROP_STATUS, &prop);
+	if (!ret && prop.intval != POWER_SUPPLY_STATUS_UNKNOWN) {
+		*val = prop.intval;
+		return 0;
+	}
+
+	/* Fallback: classify by averaged current and voltage */
+	ret = qcom_qg_get_current(chip,
+				QG_S2_NORMAL_AVG_I_DATA0_REG, &ucur);
+	if (ret)
+		return ret;
+
+	ret = qcom_qg_get_voltage(chip,
+				QG_S2_NORMAL_AVG_V_DATA0_REG, &uvolt);
+	if (ret)
+		return ret;
+
+	if (ucur > QG_STATUS_CURRENT_MARGIN_UA)
+		*val = POWER_SUPPLY_STATUS_CHARGING;
+	else if (uvolt >= chip->batt_info->voltage_max_design_uv)
+		*val = POWER_SUPPLY_STATUS_FULL;
+	else
+		*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+
+	return 0;
+}
+
 static enum power_supply_property qcom_qg_props[] = {
 	POWER_SUPPLY_PROP_STATUS,
 	POWER_SUPPLY_PROP_TECHNOLOGY,
@@ -120,6 +400,8 @@ static enum power_supply_property qcom_qg_props[] = {
 	POWER_SUPPLY_PROP_CHARGE_FULL,
 	POWER_SUPPLY_PROP_CAPACITY,
 	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_MANUFACTURER,
+	POWER_SUPPLY_PROP_SERIAL_NUMBER,
 };
 
 static int qcom_qg_get_property(struct power_supply *psy,
@@ -131,10 +413,10 @@ static int qcom_qg_get_property(struct power_supply *psy,
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
-		val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
-		break;
+		return qcom_qg_get_status(chip, &val->intval);
+
 	case POWER_SUPPLY_PROP_TECHNOLOGY:
-		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LIPO;
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
 		val->intval = chip->batt_info->voltage_max_design_uv;
@@ -155,8 +437,9 @@ static int qcom_qg_get_property(struct power_supply *psy,
 			return ret;
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
-		ret = nvmem_device_read(chip->sdam, QG_SDAM_OCV_OFFSET, 4, &val->intval);
-		if (ret < 0)
+		ret = regmap_raw_read(chip->regmap, QG_SRAM_BASE +
+					QG_SDAM_OCV_OFFSET, &val->intval, 4);
+		if (ret)
 			return ret;
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
@@ -175,9 +458,9 @@ static int qcom_qg_get_property(struct power_supply *psy,
 		val->intval = chip->batt_info->charge_full_design_uah;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL:
-		ret = nvmem_device_read(chip->sdam,
-				QG_SDAM_LEARNED_CAPACITY_OFFSET, 2, &val->intval);
-		if (ret < 0)
+		ret = regmap_raw_read(chip->regmap, QG_SRAM_BASE +
+				QG_SDAM_LEARNED_CAPACITY_OFFSET, &val->intval, 2);
+		if (ret)
 			return ret;
 		val->intval *= 1000; /* mAh to uAh */
 		break;
@@ -186,6 +469,12 @@ static int qcom_qg_get_property(struct power_supply *psy,
 		if (ret)
 			return ret;
 		break;
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = chip->manufacturer;
+		break;
+	case POWER_SUPPLY_PROP_SERIAL_NUMBER:
+		val->strval = chip->serial;
+		break;
 	case POWER_SUPPLY_PROP_TEMP:
 		ret = iio_read_channel_processed
 					(chip->batt_therm_chan, &val->intval);
@@ -232,17 +521,25 @@ static int qcom_qg_probe(struct platform_device *pdev)
 		return dev_err_probe(chip->dev, ret,
 				     "Couldn't read base address\n");
 
+	/* ADC for Battery ID */
+	chip->batt_id_chan = devm_iio_channel_get(chip->dev, "batt-id");
+	if (IS_ERR(chip->batt_id_chan))
+		return dev_err_probe(chip->dev, PTR_ERR(chip->batt_id_chan),
+				     "Couldn't get batt-id IIO channel\n");
