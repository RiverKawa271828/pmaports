--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -985,17 +985,17 @@
 	struct csiphy_device_regs *regs = csiphy->regs;
 	int i;
 
-	printk(KERN_DEBUG "csiphy_isr called\n");
-
+	dev_info(csiphy->camss->dev, "csiphy_isr fired, ST0-10:");
 	for (i = 0; i < 11; i++) {
 		int c = i + 22;
 		u8 val = readl_relaxed(csiphy->base +
 			CSIPHY_3PH_CMN_CSI_COMMON_STATUSn(regs->offset,
 							  regs->common_status_offset, i));
-
+		pr_cont(" %d=%02x", i, val);
 		writel_relaxed(val, csiphy->base +
 			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, c));
 	}
+	pr_cont("\n");
 
 	writel_relaxed(0x1, csiphy->base +
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 10));
@@ -1205,9 +1205,17 @@
 		csiphy_gen1_config_lanes(csiphy, cfg, settle_cnt);
 
 	/* IRQ_MASK registers - disable all interrupts */
-	for (i = 11; i < 22; i++) {
-		writel_relaxed(0, csiphy->base +
-			       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, i));
+	if (csiphy->camss->res->version == CAMSS_7150) {
+		static const u8 masks[11] = {0xFF, 0xFF, 0xFB, 0xFF, 0x7F,
+					     0xFF, 0xFF, 0xEF, 0xFF, 0xFF, 0xFF};
+		for (i = 0; i < 11; i++)
+			writel_relaxed(masks[i], csiphy->base +
+				       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 11 + i));
+	} else {
+		for (i = 11; i < 22; i++) {
+			writel_relaxed(0, csiphy->base +
+				       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, i));
+		}
 	}
 }
 
