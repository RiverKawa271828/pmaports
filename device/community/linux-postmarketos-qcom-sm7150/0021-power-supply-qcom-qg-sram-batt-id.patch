From: phoenix port <fix@me>
Subject: [PATCH] power: supply: qcom_qg: access SRAM via regmap, add batt-id channel

Port from sm7150-mainline/linux next branch (qcom_qg.c):

- Read OCV / learned capacity directly from the QG SRAM (0xb600) via the
  PMIC regmap instead of the spmi-sdam nvmem device. The nvmem path
  returns -EINVAL for userspace reads and is one more DT node to keep
  alive; upstream dropped it.
- Request the BAT_ID ADC channel (ADC5_BAT_ID_100K_PU) like upstream,
  so the gauge node carries the battery identity input for future use.
- Report TECHNOLOGY_LIPO instead of LION (BN5A is a Li-Po pack).

Deliberately NOT taken from upstream: removal of the current-sign
inversion in qcom_qg_get_current() -- on this device PSY-positive =
charging was verified on hardware and patch 0017's status heuristic
depends on it.

Signed-off-by: phoenix port <fix@me>
---
--- a/drivers/power/supply/qcom_qg.c
+++ b/drivers/power/supply/qcom_qg.c
@@ -7,7 +7,6 @@
 #include <linux/init.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
-#include <linux/nvmem-consumer.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/platform_device.h>
@@ -21,6 +20,7 @@
 #define QG_LAST_ADC_I_DATA0_REG		0xc2 /* 2-byte 0xc2-0xc3 */
 
 /* SRAM offsets */
+#define QG_SRAM_BASE			0xb600
 #define QG_SDAM_OCV_OFFSET		0x4c /* 4-byte 0x4c-0x4f */
 #define QG_SDAM_LEARNED_CAPACITY_OFFSET	0x68 /* 2-byte 0x68-0x69 */
 
@@ -32,10 +32,9 @@
 	struct regmap *regmap;
 	unsigned int base;
 
+	struct iio_channel *batt_id_chan;
 	struct iio_channel *batt_therm_chan;
 
-	struct nvmem_device *sdam;
-
 	struct power_supply *batt_psy;
 	struct power_supply_battery_info *batt_info;
 };
@@ -180,7 +179,7 @@
 		return qcom_qg_get_status(chip, &val->intval);
 
 	case POWER_SUPPLY_PROP_TECHNOLOGY:
-		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LIPO;
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
 		val->intval = chip->batt_info->voltage_max_design_uv;
@@ -201,8 +200,9 @@
 			return ret;
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
-		ret = nvmem_device_read(chip->sdam, QG_SDAM_OCV_OFFSET, 4, &val->intval);
-		if (ret < 0)
+		ret = regmap_raw_read(chip->regmap, QG_SRAM_BASE +
+					QG_SDAM_OCV_OFFSET, &val->intval, 4);
+		if (ret)
 			return ret;
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
@@ -221,9 +221,9 @@
 		val->intval = chip->batt_info->charge_full_design_uah;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL:
-		ret = nvmem_device_read(chip->sdam,
-				QG_SDAM_LEARNED_CAPACITY_OFFSET, 2, &val->intval);
-		if (ret < 0)
+		ret = regmap_raw_read(chip->regmap, QG_SRAM_BASE +
+				QG_SDAM_LEARNED_CAPACITY_OFFSET, &val->intval, 2);
+		if (ret)
 			return ret;
 		val->intval *= 1000; /* mAh to uAh */
 		break;
@@ -278,18 +278,18 @@
 		return dev_err_probe(chip->dev, ret,
 				     "Couldn't read base address\n");
 
+	/* ADC for Battery ID */
+	chip->batt_id_chan = devm_iio_channel_get(chip->dev, "batt-id");
+	if (IS_ERR(chip->batt_id_chan))
+		return dev_err_probe(chip->dev, PTR_ERR(chip->batt_id_chan),
+				     "Couldn't get batt-id IIO channel\n");
+
 	/* ADC for thermal channel */
 	chip->batt_therm_chan = devm_iio_channel_get(chip->dev, "batt-therm");
 	if (IS_ERR(chip->batt_therm_chan))
 		return dev_err_probe(chip->dev, PTR_ERR(chip->batt_therm_chan),
 				     "Couldn't get batt-therm IIO channel\n");
 
-	/* NVMEM for SDAM access */
-	chip->sdam = devm_nvmem_device_get(chip->dev, NULL);
-	if (IS_ERR(chip->sdam))
-		return dev_err_probe(chip->dev, PTR_ERR(chip->sdam),
-				     "Couldn't get SDAM nvmem device\n");
-
 	psy_cfg.drv_data = chip;
 	psy_cfg.fwnode = dev_fwnode(chip->dev);
 
