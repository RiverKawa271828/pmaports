+						4140900 4139800 4112100 4109300 4118600 4121700 4118900 4117800
+						4093800 4091200 4097800 4099900 4097300 4096300 4072400 4070400
+						4077100 4079300 4076600 4075600 4047300 4046900 4056500 4059600
+						4056700 4055300 4020500 4023300 4036100 4040000 4037200 4035900
+						3990300 4000700 4016000 4019400 4017800 4017300 3959900 3978800
+						3996300 3999300 3999100 3999400 3938700 3958300 3977100 3982200
+						3982100 3982500 3923900 3939000 3958500 3967800 3967300 3967000
+						3910100 3920200 3939100 3951200 3950500 3949700 3895300 3900800
+						3916700 3927100 3927000 3926600 3880500 3882000 3894200 3901300
+						3901800 3901900 3865400 3866300 3876700 3882200 3882900 3883200
+						3849400 3852800 3862400 3866700 3867800 3868100 3835800 3840500
+						3849800 3853600 3854900 3855200 3826400 3828100 3838500 3842300
