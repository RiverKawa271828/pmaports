+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Stock battery profile for Xiaomi POCO X2 (phoenix), battery
+ * G7BNVTBM4P_4500mAh (BAT_ID ~100 kOhm).  Values extracted from the
+ * stock dtbo (fdt-05) pc-temp-v2-lut; stock stores OCV in units of
+ * 100 uV, converted to uV here.  Rows = SOC * 100 (descending),
+ * columns = temperature degC (ascending).  Consumed by qcom_qg to
+ * estimate capacity from open-circuit voltage like stock does.
+ */
+
+&pm6150_qgauge {
+	/* Stock battery profile LUT (G7BNVTBM4P_4500mAh, extracted from
+	 * stock dtbo fdt-05; OCV uV indexed by SOC x100 rows x temp degC cols).
+	 * Replaces the voltage-linear capacity estimate. */
+	qcom,ocv-temp-legend = <(-10) 0 10 25 40 50>;
+	qcom,ocv-soc-legend = <						10000 9800 9600 9400 9200 9000 8800 8600
+						8400 8200 8000 7800 7600 7400 7200 7000
+						6800 6600 6400 6200 6000 5800 5600 5400
+						5200 5000 4800 4600 4400 4200 4000 3800
+						3600 3400 3200 3000 2800 2600 2400 2200
+						2000 1800 1600 1400 1200 1000 900 800
+						700 600 500 400 300 200 100 0>;
+	qcom,ocv-lut-data = <						4387500 4385000 4383000 4381500 4376500 4375000 4355000 4353500
+						4355600 4355700 4351100 4349500 4324600 4323900 4329200 4330500
+						4326300 4324700 4296800 4296600 4303700 4306000 4302200 4300600
+						4271400 4271500 4279300 4282300 4278900 4277500 4246900 4247000
+						4255200 4258700 4255700 4254400 4222700 4222500 4231400 4235200
+						4232300 4231100 4199100 4198400 4207800 4211800 4208900 4207800
+						4175900 4174600 4184700 4188800 4186000 4184900 4153000 4150700
