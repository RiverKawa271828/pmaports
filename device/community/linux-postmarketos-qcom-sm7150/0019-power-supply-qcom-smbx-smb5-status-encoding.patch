From: phoenix port <fix@me>
Subject: [PATCH] power: supply: qcom_smbx: use SMB5 status encoding on SMB5

BATTERY_CHARGER_STATUS_1 uses different status encodings on SMB2 vs
SMB5 hardware. Per downstream smb5-reg.h, SMB5 encodes:
  0=INHIBIT 1=TRICKLE 2=PRE 3=FULLON 4=TAPER 5=TERMINATE
  6=PAUSE   7=DISABLE
while the driver applies the SMB2 encoding (0=TRICKLE ... 6=INHIBIT)
to both generations.

On PM6150/phoenix a wall charger attach ends in status 6 (=PAUSE,
a fault pause - not charge termination!), which the SMB2 mapping
reports as POWER_SUPPLY_STATUS_FULL while the battery drains.
Decode per generation.

Signed-off-by: phoenix port <fix@me>
---
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -204,6 +204,14 @@ enum smb_generation {
 #define CURRENT_MAX_UA					DCP_CURRENT_UA
 /* clang-format on */
 
+/*
+ * BATTERY_CHARGER_STATUS_1 encoding. NOTE: SMB5 (PM8150B/PM6150) uses a
+ * different encoding from SMB2, per the downstream smb5-reg.h:
+ *   0=INHIBIT 1=TRICKLE 2=PRE 3=FULLON 4=TAPER 5=TERMINATE
+ *   6=PAUSE   7=DISABLE
+ * The values below are the SMB2 encoding; smb_get_prop_status() translates
+ * for SMB5.
+ */
 enum charger_status {
 	TRICKLE_CHARGE = 0,
 	PRE_CHARGE,
@@ -215,6 +223,18 @@ enum charger_status {
 	DISABLE_CHARGE,
 };
 
+/* SMB5 BATTERY_CHARGER_STATUS_1 decoding */
+enum smb5_charger_status {
+	SMB5_INHIBIT_CHARGE = 0,
+	SMB5_TRICKLE_CHARGE,
+	SMB5_PRE_CHARGE,
+	SMB5_FULLON_CHARGE,
+	SMB5_TAPER_CHARGE,
+	SMB5_TERMINATE_CHARGE,
+	SMB5_PAUSE_CHARGE,
+	SMB5_DISABLE_CHARGE,
+};
+
 struct smb_init_register {
 	u16 addr;
 	u8 mask;
@@ -407,6 +427,28 @@ static int smb_get_prop_status(struct smb_chip *chip, int *val)
 
 	stat = stat & BATTERY_CHARGER_STATUS_MASK;
 
+	if (chip->gen == SMB5) {
+		switch (stat) {
+		case SMB5_TRICKLE_CHARGE:
+		case SMB5_PRE_CHARGE:
+		case SMB5_FULLON_CHARGE:
+		case SMB5_TAPER_CHARGE:
+			*val = POWER_SUPPLY_STATUS_CHARGING;
+			return rc;
+		case SMB5_DISABLE_CHARGE:
+		case SMB5_PAUSE_CHARGE:
+			*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+			return rc;
+		case SMB5_TERMINATE_CHARGE:
+		case SMB5_INHIBIT_CHARGE:
+			*val = POWER_SUPPLY_STATUS_FULL;
+			return rc;
+		default:
+			*val = POWER_SUPPLY_STATUS_UNKNOWN;
+			return rc;
+		}
+	}
+
 	switch (stat) {
 	case TRICKLE_CHARGE:
 	case PRE_CHARGE:
