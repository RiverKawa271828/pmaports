From: phoenix port <fix@me>
Subject: [PATCH] media: venus: debug and workaround knobs for non-idling firmware

The sm7150 stock video firmware (VIDEO.IR.1.2-00022-PROD-1) boots,
answers HFI and reports zero errors, but its CPU never enters WFI and
SCIACMDARG0 idle is never asserted, so the runtime-suspend idle check
in venus_suspend_3xx() times out after 150ms and probe fails with
-ETIMEDOUT.  Measured on-device: WRAPPER_CPU_STATUS stays 0x00000000 and
CPU_CS_SCIACMDARG0 stays 0x00000001 throughout the poll window.

No newer phoenix-signed firmware exists (MIUI V13 stopped shipping
venus.mbn), so iterate from the kernel side.  Add three knobs that all
default to the current behaviour, switchable at module load:

- fw_debug: module param for the firmware debug verbosity bitmask, so
  LOW/MED firmware logs can be collected on a probe that never succeeds
  (the debugfs fw_level file is only created on a successful probe).
- keep_powered: skip runtime suspend and power-collapse entirely; the
  video core stays powered, probe proceeds and sessions can be tested
  end-to-end.
- dump WRAPPER_CPU_STATUS/SCIACMDARG0/WRAPPER_INTR_STATUS and the raw
  firmware version string when the known failures hit, to stop guessing.

Signed-off-by: phoenix port <fix@me>

---
--- a/drivers/media/platform/qcom/venus/core.c	2026-09-01 03:24:18.983107893 +0800
+++ b/drivers/media/platform/qcom/venus/core.c	2026-09-01 03:24:39.259088173 +0800
@@ -574,12 +574,24 @@
 	pm_runtime_put_sync(core->dev);
 }
 
+static bool venus_keep_powered;
+module_param_named(keep_powered, venus_keep_powered, bool, 0444);
+MODULE_PARM_DESC(keep_powered,
+		 "Skip runtime suspend/power-collapse entirely (the video core "
+		 "stays powered at all times).  Workaround for firmware that "
+		 "never enters idle/WFI, e.g. sm7150 VIDEO.IR.1.2-00022.");
+
 static __maybe_unused int venus_runtime_suspend(struct device *dev)
 {
 	struct venus_core *core = dev_get_drvdata(dev);
 	const struct venus_pm_ops *pm_ops = core->pm_ops;
 	int ret;
 
+	if (venus_keep_powered) {
+		dev_dbg(dev, "keep_powered: skipping runtime suspend\n");
+		return 0;
+	}
+
 	ret = hfi_core_suspend(core);
 	if (ret)
 		return ret;
@@ -635,6 +647,15 @@
 	const struct venus_pm_ops *pm_ops = core->pm_ops;
 	int ret;
 
+	/*
+	 * With keep_powered the core was never actually powered down, so
+	 * skip the power-on/HFI restart sequence once the core has been
+	 * initialised.  The very first resume during probe must still run
+	 * (core->state is CORE_UNINIT then).
+	 */
+	if (venus_keep_powered && core->state >= CORE_INIT)
+		return 0;
+
 	ret = icc_set_bw(core->video_path, kbps_to_icc(20000), 0);
 	if (ret)
 		return ret;
--- a/drivers/media/platform/qcom/venus/hfi_venus.c	2026-09-01 03:24:18.983178194 +0800
+++ b/drivers/media/platform/qcom/venus/hfi_venus.c	2026-09-01 03:25:07.512725759 +0800
@@ -10,6 +10,7 @@
 #include <linux/interrupt.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
+#include <linux/module.h>
 #include <linux/slab.h>
 
 #include "core.h"
@@ -131,6 +132,10 @@
 
 static bool venus_pkt_debug;
 int venus_fw_debug = HFI_DEBUG_MSG_ERROR | HFI_DEBUG_MSG_FATAL;
+module_param_named(fw_debug, venus_fw_debug, int, 0444);
+MODULE_PARM_DESC(fw_debug,
+		 "Video firmware debug verbosity bitmask (1=low 2=med 4=high "
+		 "8=error 16=fatal 32=perf); sent to the firmware at core init");
 static bool venus_fw_low_power_mode = true;
 static int venus_hw_rsp_timeout = 1000;
 static bool venus_fw_coverage;
@@ -1584,6 +1589,7 @@
 	struct venus_hfi_device *hdev = to_hfi_priv(core);
 	struct device *dev = core->dev;
 	void __iomem *cpu_cs_base = hdev->core->cpu_cs_base;
+	void __iomem *wrapper_base = hdev->core->wrapper_base;
 	u32 ctrl_status;
 	bool val;
 	int ret;
@@ -1616,6 +1622,10 @@
 				 1500, 100 * 1500);
 	if (ret) {
 		dev_err(dev, "wait for cpu and video core idle fail (%d)\n", ret);
+		dev_err(dev, "cpu_status %#x ctrl_status %#x intr_status %#x\n",
+			readl(wrapper_base + WRAPPER_CPU_STATUS),
+			ctrl_status,
+			readl(wrapper_base + WRAPPER_INTR_STATUS));
 		return ret;
 	}
 
--- a/drivers/media/platform/qcom/venus/hfi_msgs.c	2026-09-01 03:24:18.983244497 +0800
+++ b/drivers/media/platform/qcom/venus/hfi_msgs.c	2026-09-01 03:25:14.065641703 +0800
@@ -322,6 +322,8 @@
 		goto done;
 
 	dev_err(dev, VDBGL "error reading F/W version\n");
+	dev_err(dev, VDBGL "raw F/W version string (%d bytes): %.*s\n",
+		req_bytes, min(req_bytes, 64), (const char *)img_ver);
 	return;
 
 done:
