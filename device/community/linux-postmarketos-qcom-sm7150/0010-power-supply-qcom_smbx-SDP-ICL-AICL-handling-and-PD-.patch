From 84dca98ca1a3fbfa64e51a77f613716930ef3ef4 Mon Sep 17 00:00:00 2001
From: phoenix port <fix@me>
Date: Fri, 18 Sep 2026 09:17:18 +0800
Subject: [PATCH 10/13] power: supply: qcom_smbx: SDP ICL/AICL handling and PD
 voltage follow

Legacy series consolidation: recharge-after-termination fix, AICL/ICL
status handling, USB51 clearing for non-SDP, SMB5 status encoding,
follow negotiated PD voltage, APSD rerun on ICL change.
---
 drivers/power/supply/qcom_smbx.c | 361 ++++++++++++++++++++++++++++++-
 1 file changed, 359 insertions(+), 2 deletions(-)

diff --git a/drivers/power/supply/qcom_smbx.c b/drivers/power/supply/qcom_smbx.c
index 1d1d0416b..2710b5a8f 100644
--- a/drivers/power/supply/qcom_smbx.c
+++ b/drivers/power/supply/qcom_smbx.c
@@ -20,6 +20,7 @@
 #include <linux/of.h>
 #include <linux/power_supply.h>
 #include <linux/regmap.h>
+#include <linux/string.h>
 #include <linux/types.h>
 #include <linux/workqueue.h>
 
@@ -125,6 +126,29 @@ enum smb_generation {
 
 #define USBIN_CURRENT_LIMIT_CFG				0x370
 
+/* DCDC page registers, reached through the charger peripheral base */
+#define DCDC_FSW_SEL					0x150
+#define DCDC_FSW_MASK					GENMASK(3, 0)
+
+#define SMBX_FSW_2400KHZ				0x7
+#define SMBX_FSW_2100KHZ				0x8
+#define SMBX_FSW_1600KHZ				0xb
+#define SMBX_FSW_1200KHZ				0xf
+
+/*
+ * Input over-voltage protection window. It must cover the negotiated
+ * USB-PD contract voltage or the charger latches PAUSE.
+ */
+#define USBIN_ADAPTER_ALLOW_CFG				0x360
+
+enum usbin_adapter_allow {
+	USBIN_ADAPTER_ALLOW_5V				= 0x0,
+	USBIN_ADAPTER_ALLOW_9V				= 0x2,
+	USBIN_ADAPTER_ALLOW_12V				= 0x4,
+	USBIN_ADAPTER_ALLOW_5V_TO_9V			= 0x8,
+	USBIN_ADAPTER_ALLOW_5V_OR_9V_TO_12V		= 0x7,
+};
+
 #define USBIN_AICL_OPTIONS_CFG				0x380
 #define SUSPEND_ON_COLLAPSE_USBIN_BIT			BIT(7)
 #define USBIN_AICL_START_AT_MAX_BIT			BIT(5)
@@ -141,7 +165,13 @@ enum smb_generation {
 #define USBIN_CONT_AICL_THRESHOLD_CFG			0x384
 #define USBIN_CONT_AICL_THRESHOLD_CFG_MASK		GENMASK(5, 0)
 
-#define ICL_STATUS(smb)					(SMB_REG_OFFSET(smb) + 0x07)
+/* On SMB5 (PM8150B) the AICL-settled input current limit lives at +0x08;
+ * +0x07 holds the configured/instantaneous value which can read 0.
+ * SMB2 exposes a single ICL status register at +0x07. */
+#define SMB2_ICL_STATUS_REG				0x07
+#define SMB5_ICL_STATUS_REG				0x08
+#define ICL_STATUS(smb)					(SMB_REG_OFFSET(smb) + \
+			((smb)->gen == SMB5 ? SMB5_ICL_STATUS_REG : SMB2_ICL_STATUS_REG))
 #define INPUT_CURRENT_LIMIT_MASK			GENMASK(7, 0)
 
 #define POWER_PATH_STATUS(smb)				(SMB_REG_OFFSET(smb) + 0x0B)
@@ -202,8 +232,19 @@ enum smb_generation {
 #define CDP_CURRENT_UA					1500000
 #define DCP_CURRENT_UA					1500000
 #define CURRENT_MAX_UA					DCP_CURRENT_UA
+
+/* Interval for the USB-PD contract / fault-latch watchdog while online */
+#define PD_POLL_INTERVAL_MS				5000
 /* clang-format on */
 
+/*
+ * BATTERY_CHARGER_STATUS_1 encoding. NOTE: SMB5 (PM8150B/PM6150) uses a
+ * different encoding from SMB2, per the downstream smb5-reg.h:
+ *   0=INHIBIT 1=TRICKLE 2=PRE 3=FULLON 4=TAPER 5=TERMINATE
+ *   6=PAUSE   7=DISABLE
+ * The values below are the SMB2 encoding; smb_get_prop_status() translates
+ * for SMB5.
+ */
 enum charger_status {
 	TRICKLE_CHARGE = 0,
 	PRE_CHARGE,
@@ -215,6 +256,18 @@ enum charger_status {
 	DISABLE_CHARGE,
 };
 
+/* SMB5 BATTERY_CHARGER_STATUS_1 decoding */
+enum smb5_charger_status {
+	SMB5_INHIBIT_CHARGE = 0,
+	SMB5_TRICKLE_CHARGE,
+	SMB5_PRE_CHARGE,
+	SMB5_FULLON_CHARGE,
+	SMB5_TAPER_CHARGE,
+	SMB5_TERMINATE_CHARGE,
+	SMB5_PAUSE_CHARGE,
+	SMB5_DISABLE_CHARGE,
+};
+
 struct smb_init_register {
 	u16 addr;
 	u8 mask;
@@ -251,11 +304,19 @@ struct smb_chip {
 	struct delayed_work status_change_work;
 	int cable_irq;
 	bool wakeup_enabled;
+	unsigned int apsd_reruns;
 
 	struct iio_channel *usb_in_i_chan;
 	struct iio_channel *usb_in_v_chan;
 
 	struct power_supply *chg_psy;
+
+	/* USB-PD voltage following */
+	struct delayed_work pd_update_work;
+	struct notifier_block pd_nb;
+	char pd_psy_name[64];
+	unsigned int pd_allowance;
+	unsigned int pd_fsw;
 };
 
 struct smb_match_data {
@@ -372,7 +433,7 @@ static int smbx_ov_status(struct smb_chip *chip)
 	if (rc)
 		return rc;
 
-	return !!(reg & mask);
+	return !!(val & mask);
 }
 
 static int smb_get_prop_status(struct smb_chip *chip, int *val)
@@ -407,6 +468,28 @@ static int smb_get_prop_status(struct smb_chip *chip, int *val)
 
 	stat = stat & BATTERY_CHARGER_STATUS_MASK;
 
+	if (chip->gen == SMB5) {
+		switch (stat) {
+		case SMB5_TRICKLE_CHARGE:
+		case SMB5_PRE_CHARGE:
+		case SMB5_FULLON_CHARGE:
+		case SMB5_TAPER_CHARGE:
+			*val = POWER_SUPPLY_STATUS_CHARGING;
+			return rc;
+		case SMB5_DISABLE_CHARGE:
+		case SMB5_PAUSE_CHARGE:
+			*val = POWER_SUPPLY_STATUS_NOT_CHARGING;
+			return rc;
+		case SMB5_TERMINATE_CHARGE:
+		case SMB5_INHIBIT_CHARGE:
+			*val = POWER_SUPPLY_STATUS_FULL;
+			return rc;
+		default:
+			*val = POWER_SUPPLY_STATUS_UNKNOWN;
+			return rc;
+		}
+	}
+
 	switch (stat) {
 	case TRICKLE_CHARGE:
 	case PRE_CHARGE:
@@ -508,6 +591,7 @@ static int smb_set_current_limit(struct smb_chip *chip, unsigned int val)
 static void smb_status_change_work(struct work_struct *work)
 {
 	unsigned int charger_type, current_ua;
+	unsigned int stat;
 	int usb_online = 0;
 	int count, rc;
 	struct smb_chip *chip;
@@ -553,8 +637,240 @@ static void smb_status_change_work(struct work_struct *work)
 		break;
 	}
 
+	/*
+	 * USBIN_ICL_OPTIONS.USB51_MODE caps the input current at 500mA
+	 * (USB 2.0 mode). It is valid for SDP only; leave it set for
+	 * CDP/DCP and the programmed ICL below gets silently clamped to
+	 * 500mA, leaving zero net charge current -- observed on PM6150
+	 * (phoenix): DCP chargers latched INHIBIT_CHARGE / STATUS=Full
+	 * forever while the battery drained.
+	 */
+	regmap_update_bits(chip->regmap, chip->base + USBIN_ICL_OPTIONS,
+			   USB51_MODE_BIT,
+			   charger_type == POWER_SUPPLY_USB_TYPE_SDP ?
+			   USB51_MODE_BIT : 0);
+
 	smb_set_current_limit(chip, current_ua);
+
+	/*
+	 * If the charger is in terminate/inhibit state from an earlier
+	 * charge cycle, the hardware only restarts charging once the
+	 * recharge threshold is crossed again. Devices whose fuel gauge
+	 * data is uncalibrated may never report a stable SOC, leaving the
+	 * input current limit at 0 and the battery draining while the
+	 * charger reports "Full". Kick a fresh charge cycle whenever we
+	 * (re)detect a charger in such a state.
+	 */
+	rc = regmap_read(chip->regmap,
+			 chip->base + BATTERY_CHARGER_STATUS_1, &stat);
+	if (rc >= 0) {
+		stat &= BATTERY_CHARGER_STATUS_MASK;
+		if (stat == TERMINATE_CHARGE || stat == INHIBIT_CHARGE) {
+			dev_dbg(chip->dev,
+				"charge terminated, forcing recharge\n");
+			regmap_update_bits(chip->regmap,
+					   chip->base + USBIN_CMD_IL,
+					   USBIN_SUSPEND_BIT, 0);
+			regmap_write(chip->regmap,
+				     chip->base + CHARGING_ENABLE_CMD, 0);
+			usleep_range(1000, 2000);
+			regmap_write(chip->regmap,
+				     chip->base + CHARGING_ENABLE_CMD,
+				     CHARGING_ENABLE_CMD_BIT);
+		}
+	}
+
 	power_supply_changed(chip->chg_psy);
+
+	/*
+	 * Re-evaluate the PD contract on plug events too, in case the psy
+	 * notifier was registered after the contract was established.
+	 */
+	schedule_delayed_work(&chip->pd_update_work, 0);
+}
+
+static int smb_pd_find_psy(struct device *dev, void *data);
+
+static void smb_pd_update_work(struct work_struct *work)
+{
+	struct smb_chip *chip = container_of(to_delayed_work(work),
+					     struct smb_chip, pd_update_work);
+	unsigned int allow, fsw, vmax_uv = 0;
+	union power_supply_propval val = { 0 };
+	struct power_supply *psy;
+	unsigned int online = 0, stat;
+	bool have_psy = true;
+	int rc;
+
+	if (!chip->pd_psy_name[0]) {
+		/*
+		 * No notifier event seen yet (e.g. charger was already
+		 * plugged before we probed): look for the TCPM psy among
+		 * the sibling devices of our PMIC.
+		 */
+		bus_for_each_dev(&platform_bus_type, NULL, chip,
+				 smb_pd_find_psy);
+		if (!chip->pd_psy_name[0])
+			have_psy = false;
+	}
+
+	smb_get_prop_usb_online(chip, &online);
+
+	if (!have_psy) {
+		/* TCPM may still be probing; retry while input is present */
+		if (online)
+			goto reschedule;
+		return;
+	}
+
+	psy = power_supply_get_by_name(chip->pd_psy_name);
+	if (!psy) {
+		if (online)
+			goto reschedule;
+		return;
+	}
+
+	rc = power_supply_get_property(psy, POWER_SUPPLY_PROP_VOLTAGE_MAX,
+				       &val);
+	if (!rc && val.intval > 0)
+		vmax_uv = val.intval;
+	power_supply_put(psy);
+
+	if (chip->gen != SMB5)
+		return; /* PD voltage following only validated on SMB5 */
+
+	/*
+	 * Mirror downstream smb5-lib smblib_set_usb_pd_allowed_voltage() /
+	 * smblib_set_usb_pd_fsw(): switcher frequency and input OV window
+	 * must track the negotiated PD contract or USBIN_OV fires and
+	 * charging latches PAUSE. With no contract keep the reset default
+	 * window (5V or 9-12V), which also covers legacy DCP chargers.
+	 */
+	if (vmax_uv <= 5500000) {
+		allow = USBIN_ADAPTER_ALLOW_5V_OR_9V_TO_12V;
+		fsw = SMBX_FSW_2400KHZ;
+	} else if (vmax_uv < 9000000) {
+		allow = USBIN_ADAPTER_ALLOW_5V_TO_9V;
+		fsw = SMBX_FSW_2100KHZ;
+	} else if (vmax_uv < 12000000) {
+		allow = USBIN_ADAPTER_ALLOW_9V;
+		fsw = SMBX_FSW_1600KHZ;
+	} else {
+		allow = USBIN_ADAPTER_ALLOW_12V;
+		fsw = SMBX_FSW_1200KHZ;
+	}
+
+	/* FSW first, then widen/narrow the window, like downstream does */
+	if (allow != chip->pd_allowance || fsw != chip->pd_fsw) {
+		rc = regmap_update_bits(chip->regmap, chip->base + DCDC_FSW_SEL,
+					DCDC_FSW_MASK, fsw);
+		if (rc < 0) {
+			dev_err(chip->dev, "Couldn't set FSW for %u uV: %d\n",
+				vmax_uv, rc);
+			goto reschedule;
+		}
+
+		rc = regmap_write(chip->regmap,
+				  chip->base + USBIN_ADAPTER_ALLOW_CFG, allow);
+		if (rc < 0) {
+			dev_err(chip->dev,
+				"Couldn't set adapter allowance: %d\n", rc);
+			goto reschedule;
+		}
+
+		chip->pd_allowance = allow;
+		chip->pd_fsw = fsw;
+
+		dev_info(chip->dev,
+			 "PD follow: %u uV -> allowance 0x%02x fsw 0x%02x\n",
+			 vmax_uv, allow, fsw);
+	}
+
+	/*
+	 * A contract change while the input OV window was still wrong can
+	 * leave the charger latched in PAUSE/INHIBIT even after the window
+	 * is fixed (observed on PM6150), and AICL collapses can latch PAUSE
+	 * at runtime. Check on every pass and force a fresh charge cycle.
+	 */
+	if (online && chip->gen == SMB5) {
+		rc = regmap_read(chip->regmap,
+				 chip->base + BATTERY_CHARGER_STATUS_1, &stat);
+		if (rc >= 0) {
+			stat &= BATTERY_CHARGER_STATUS_MASK;
+			if (stat == SMB5_INHIBIT_CHARGE ||
+			    stat == SMB5_PAUSE_CHARGE ||
+			    stat == SMB5_DISABLE_CHARGE) {
+				dev_info(chip->dev,
+					 "PD follow: kicking charger out of status %u\n",
+					 stat);
+				regmap_update_bits(chip->regmap,
+						   chip->base + USBIN_CMD_IL,
+						   USBIN_SUSPEND_BIT, 0);
+				regmap_write(chip->regmap,
+					     chip->base + CHARGING_ENABLE_CMD,
+					     0);
+				usleep_range(1000, 2000);
+				regmap_write(chip->regmap,
+					     chip->base + CHARGING_ENABLE_CMD,
+					     CHARGING_ENABLE_CMD_BIT);
+			}
+		}
+	}
+
+reschedule:
+	/*
+	 * Keep re-checking while an input is present so that fault latches
+	 * are recovered and late contract changes get picked up; the loop
+	 * stops itself once the input goes away.
+	 */
+	schedule_delayed_work(&chip->pd_update_work,
+			      msecs_to_jiffies(PD_POLL_INTERVAL_MS));
+}
+
+static int smb_pd_find_psy(struct device *dev, void *data)
+{
+	struct smb_chip *chip = data;
+	struct power_supply *psy;
+	const char *name;
+
+	/* TCPM psy name is "tcpm-source-psy-" + the typec device name */
+	if (dev->parent != chip->dev->parent ||
+	    !str_has_prefix(dev_name(dev), "typec"))
+		return 0;
+
+	name = kasprintf(GFP_KERNEL, "tcpm-source-psy-%s", dev_name(dev));
+	if (!name)
+		return 0;
+
+	psy = power_supply_get_by_name(name);
+	if (!psy) {
+		kfree(name);
+		return 0;
+	}
+	power_supply_put(psy);
+
+	strscpy(chip->pd_psy_name, name, sizeof(chip->pd_psy_name));
+	dev_info(chip->dev, "tracking %s for PD voltage follow\n", name);
+	kfree(name);
+	return 1;
+}
+
+static int smb_pd_notifier_call(struct notifier_block *nb,
+				unsigned long ev, void *v)
+{
+	struct smb_chip *chip = container_of(nb, struct smb_chip, pd_nb);
+	struct power_supply *psy = v;
+
+	if (ev != PSY_EVENT_PROP_CHANGED || !psy || !psy->desc ||
+	    !psy->desc->name ||
+	    !str_has_prefix(psy->desc->name, "tcpm-source-psy"))
+		return NOTIFY_OK;
+
+	strscpy(chip->pd_psy_name, psy->desc->name,
+		sizeof(chip->pd_psy_name));
+	schedule_delayed_work(&chip->pd_update_work, 0);
+
+	return NOTIFY_OK;
 }
 
 static int smb_get_iio_chan(struct smb_chip *chip, struct iio_channel *chan,
@@ -743,6 +1059,8 @@ static irqreturn_t smb_handle_usb_plugin(int irq, void *data)
 {
 	struct smb_chip *chip = data;
 
+	chip->apsd_reruns = 0;
+
 	power_supply_changed(chip->chg_psy);
 
 	schedule_delayed_work(&chip->status_change_work,
@@ -757,6 +1075,22 @@ static irqreturn_t smb_handle_usb_icl_change(int irq, void *data)
 
 	power_supply_changed(chip->chg_psy);
 
+	/*
+	 * An ICL change usually means AICL re-settled because the input
+	 * source buckled under the previously programmed limit -- the
+	 * signature of a misclassified port (e.g. an SDP port running
+	 * with the DCP limit, which drains the battery instead of
+	 * charging).  Force a fresh APSD run and re-evaluate the type,
+	 * bounded so the detection current steps cannot ping-pong us.
+	 */
+	if (chip->apsd_reruns < 3) {
+		chip->apsd_reruns++;
+		regmap_write(chip->regmap, chip->base + CMD_APSD,
+			     APSD_RERUN_BIT);
+		schedule_delayed_work(&chip->status_change_work,
+				      msecs_to_jiffies(300));
+	}
+
 	return IRQ_HANDLED;
 }
 
@@ -1168,6 +1502,29 @@ static int smb_probe(struct platform_device *pdev)
 		return dev_err_probe(chip->dev, rc,
 				     "Couldn't write fast AICL rerun time");
 
+	/*
+	 * Track USB-PD contract changes from the Type-C TCPM so that the
+	 * switcher frequency and the input OV window follow the negotiated
+	 * voltage.
+	 */
+	rc = devm_delayed_work_autocancel(chip->dev, &chip->pd_update_work,
+					  smb_pd_update_work);
+	if (rc)
+		return dev_err_probe(chip->dev, rc,
+				     "Failed to init PD update work\n");
+
+	chip->pd_nb.notifier_call = smb_pd_notifier_call;
+	rc = power_supply_reg_notifier(&chip->pd_nb);
+	if (rc < 0)
+		return dev_err_probe(chip->dev, rc,
+				     "Couldn't register PD notifier\n");
+
+	/*
+	 * The TCPM may have negotiated a contract before we registered the
+	 * notifier (charger probes late), so sync once unconditionally.
+	 */
+	schedule_delayed_work(&chip->pd_update_work, 0);
+
 	/* Initialise charger state */
 	schedule_delayed_work(&chip->status_change_work, 0);
 
-- 
2.43.0

